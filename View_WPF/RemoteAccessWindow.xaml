<Window x:Class="View_WPF.RemoteAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCPWorkCenter - Remote Access"
        Width="960"
        Height="600"
        MinWidth="820"
        MinHeight="520"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="#F4F6FB">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                CornerRadius="10"
                Padding="18,14"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Global Remote Access"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A" />

                    <TextBlock Grid.Row="2"
                               Text="Share your screen using ID &amp; Password or connect to a remote computer."
                               FontSize="13"
                               Foreground="#64748B" />
                </Grid>

                <Border Grid.Column="1"
                        Background="#EFF6FF"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtConnectionStatus"
                               Text="Status: Ready"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#1D4ED8" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    Padding="22"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Allow Remote Control"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />

                    <TextBlock Grid.Row="2"
                               Text="Give this ID and Password to an authorized person to control this PC."
                               FontSize="12.5"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4"
                               Text="Your Remote ID"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="#334155" />

                    <TextBox x:Name="txtMyRemoteId"
                             Grid.Row="6"
                             IsReadOnly="True"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#0F172A"
                             Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Padding="12,8"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="8"
                               Text="Temporary Password"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="#334155" />

                    <TextBox x:Name="txtMyPassword"
                             Grid.Row="10"
                             IsReadOnly="True"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="#0F172A"
                             Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Padding="12,8"
                             VerticalContentAlignment="Center" />

                    <Grid Grid.Row="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnGenerateSession"
                                Grid.Column="0"
                                Content="Generate ID &amp; Password"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF"
                                Background="#2563EB"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnGenerateSession_Click" />

                        <Button x:Name="btnStopHosting"
                                Grid.Column="2"
                                Content="Stop"
                                Width="84"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF"
                                Background="#DC2626"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsEnabled="False"
                                Click="btnStopHosting_Click" />
                    </Grid>

                    <TextBlock x:Name="txtHostExpiryInfo"
                               Grid.Row="14"
                               Text="Click Generate to create a temporary session."
                               FontSize="12"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    Padding="22"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Control Remote Computer"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0F172A" />

                    <TextBlock Grid.Row="2"
                               Text="Enter the partner's Remote ID and Password to start a session."
                               FontSize="12.5"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4"
                               Text="Partner Remote ID"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="#334155" />

                    <TextBox x:Name="txtPartnerRemoteId"
                             Grid.Row="6"
                             FontSize="15"
                             Foreground="#0F172A"
                             Background="#FFFFFF"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Padding="12,8"
                             VerticalContentAlignment="Center" />

                    <TextBlock Grid.Row="8"
                               Text="Partner Password"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="#334155" />

                    <PasswordBox x:Name="pwdPartnerPassword"
                                 Grid.Row="10"
                                 FontSize="15"
                                 Foreground="#0F172A"
                                 Background="#FFFFFF"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Padding="12,8"
                                 VerticalContentAlignment="Center" />

                    <Button x:Name="btnConnectPartner"
                            Grid.Row="12"
                            Content="Connect to Remote PC"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="#FFFFFF"
                            Background="#059669"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnConnectPartner_Click" />

                    <TextBlock x:Name="txtViewerStatusInfo"
                               Grid.Row="14"
                               Text="Ready to connect."
                               FontSize="12"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="#FFFFFF"
                CornerRadius="8"
                Padding="14,10"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtFooterNote"
                           Grid.Column="0"
                           Text="Sessions expire automatically after 30 minutes or when stopped."
                           FontSize="12"
                           Foreground="#64748B"
                           VerticalAlignment="Center" />

                <Button x:Name="btnCloseWindow"
                        Grid.Column="1"
                        Content="Close"
                        Width="90"
                        Height="32"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        Background="#E2E8F0"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnCloseWindow_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>