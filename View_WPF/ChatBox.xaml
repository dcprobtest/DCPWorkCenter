<Window x:Class="View_WPF.ChatBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCPBD Operation" Height="650" Width="450" 
        Background="#F8F9FA"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" ShadowDepth="1" BlurRadius="5" Opacity="0.1" Direction="270"/>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                             From="10" To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6264A7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#50528A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Effect="{DynamicResource DropShadowEffect}" Padding="20,0">
            <TextBlock Text="DCPBD Operation" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="18" Foreground="#2C3E50"/>
        </Border>

        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10">
            <ItemsControl x:Name="ChatListBox" ItemsSource="{Binding Messages}" Margin="15,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8" Opacity="1" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="{Binding Alignment}">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding DateSeparator}" HorizontalAlignment="Center" 
                                       Foreground="#AAB8C2" FontSize="10" Margin="5"/>

                            <TextBlock Grid.Row="1" Text="{Binding SenderInfo}" 
                                       FontSize="10" 
                                       Foreground="Gray" 
                                       Margin="2,0,0,2"/>

                            <Border Grid.Row="2" CornerRadius="{Binding BubbleRadius}" Background="{Binding BubbleColor}" 
                                    Padding="14,10" MaxWidth="320"
                                    Effect="{DynamicResource DropShadowEffect}">

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Reply" Command="{Binding ReplyCommand}"/>
                                        <MenuItem Header="Copy" Command="{Binding CopyCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Delete">
                                            <MenuItem Header="Delete for me" Command="{Binding DeleteForMeCommand}"/>
                                            <MenuItem Header="Delete for everyone" Command="{Binding DeleteForEveryoneCommand}"/>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Quoted / Replied Message Preview inside the bubble -->
                                    <Border Grid.Row="0" Background="#20000000" CornerRadius="4" Padding="8,4" Margin="0,0,0,6"
                                            Visibility="{Binding ReplyPreviewVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="Replying to:" FontSize="9" Foreground="#DDDDDD" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ReplyText}" FontSize="11" Foreground="#EEEEEE" TextTrimming="CharacterEllipsis" MaxWidth="290"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Main Message Text -->
                                    <TextBlock Grid.Row="1" Foreground="{Binding TextColor}" 
                                               FontSize="14" TextWrapping="Wrap" LineHeight="20">
                                        <Hyperlink NavigateUri="{Binding Message}" 
                                                   Command="{Binding OpenLinkCommand}" 
                                                   CommandParameter="{Binding Message}"
                                                   Foreground="{Binding TextColor}"
                                                   TextDecorations="{x:Null}">
                                            <Run Text="{Binding Message}"/>
                                        </Hyperlink>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#B0B0B0" FontSize="9" 
                                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area with Dynamic Reply Preview Panel -->
        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F1F2F6" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" 
                        Visibility="{Binding ReplyContainerVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Replying to message:" FontSize="10" Foreground="#6264A7" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ReplyingToMessage}" FontSize="12" Foreground="#333333" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Background="Transparent" BorderBrush="{x:Null}" 
                                Foreground="Gray" FontWeight="Bold" Cursor="Hand" Command="{Binding CancelReplyCommand}"
                                VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputTextBox" VerticalContentAlignment="Center" BorderBrush="#E1E1E1" 
                             Margin="0,0,10,0" TextWrapping="Wrap" AcceptsReturn="True" Height="45" 
                             Padding="10,0" VerticalScrollBarVisibility="Auto" KeyDown="InputTextBox_KeyDown"/>

                    <Button Grid.Column="1" Content="Send" Style="{StaticResource SendButtonStyle}" 
                            Click="SendButton_Click" Cursor="Hand" Height="45"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>