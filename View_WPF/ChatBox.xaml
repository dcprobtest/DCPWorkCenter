<Window x:Class="View_WPF.ChatBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCPBD Operation" Height="650" Width="450" 
        Background="#F8F9FA"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" ShadowDepth="1" BlurRadius="5" Opacity="0.1" Direction="270"/>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                             From="10" To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6264A7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#50528A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Effect="{DynamicResource DropShadowEffect}" Padding="20,0">
            <TextBlock Text="DCPBD Operation" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="18" Foreground="#2C3E50"/>
        </Border>

        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10">
            <ItemsControl x:Name="ChatListBox" Margin="15,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8" Opacity="1" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="{Binding Alignment}">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding DateSeparator}" HorizontalAlignment="Center" 
                                       Foreground="#AAB8C2" FontSize="10" Margin="5" Visibility="{Binding DateVisibility}"/>

                            <TextBlock Grid.Row="1" Text="{Binding SenderInfo}" 
                                       FontSize="10" 
                                       Foreground="Gray" 
                                       Margin="2,0,0,2"/>

                            <Border Grid.Row="2" CornerRadius="{Binding BubbleRadius}" Background="{Binding BubbleColor}" 
                                    Padding="14,10" MaxWidth="320"
                                    Effect="{DynamicResource DropShadowEffect}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Message}" Foreground="{Binding TextColor}" 
                                               FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
                                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="#B0B0B0" FontSize="9" 
                                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InputTextBox" VerticalContentAlignment="Center" BorderBrush="#E1E1E1" 
                         Margin="0,0,10,0" TextWrapping="Wrap" AcceptsReturn="True" Height="45" 
                         Padding="10,0" VerticalScrollBarVisibility="Auto" KeyDown="InputTextBox_KeyDown"/>

                <Button Grid.Column="1" Content="Send" Style="{StaticResource SendButtonStyle}" 
                        Click="SendButton_Click" Cursor="Hand" Height="45"/>
            </Grid>
        </Border>
    </Grid>
</Window>