<Window x:Class="View_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCP Dashboard" 
        Height="850" Width="1050" 
        WindowState="Maximized" 
        Background="White">

    <Window.Resources>
        <Style x:Key="OptionCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CardContainer" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="GradientBorder" CornerRadius="25" Padding="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.25"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFF" Offset="0.75"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#33007AFF" Width="1200" Height="1200" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-300,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#266200EE" Width="1600" Height="1400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-400,-400">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Select a Service" FontSize="56" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,60">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleMove" Y="40"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="450"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>

                <Button Grid.Column="0" Grid.Row="0" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card1Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" Source="/Untitled_design-removebg-preview.png" Height="120" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Video Class" FontSize="24" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="0" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card2Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" Source="/4859897-removebg-preview.png" Height="120" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Video Conference" FontSize="24" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    </Grid>
                </Button>

                <Button Grid.Column="0" Grid.Row="1" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card3Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" Source="/numix-circle-for-windows-file-manager-blue-icon-png-icon-thumbnail-removebg-preview.png" Height="120" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="File Manager" FontSize="24" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="1" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card4Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" Source="/mentor-laptop-icon-vector-isolated-contour-symbol-illustration-2AW9E0R-removebg-preview.png" Height="120" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Remote Access" FontSize="24" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    </Grid>
                </Button>

                <Button Grid.Column="0" Grid.Row="2" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card5Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="100" Width="100" VerticalAlignment="Center">
                            <Path Fill="#FF9800" Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Admin Forms" FontSize="24" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="2" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card6Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="100" Width="100" VerticalAlignment="Center">
                            <Path Fill="#BD00FF" Data="M19,3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.11,21 21,20.1 21,19V5C21,3.9 20.11,3 19,3M19,19H5V5H19V19M7,10H9V12H7V10M7,14H9V16H7V14M7,6H9V8H7V6M11,10H17V12H11V10M11,14H17V16H11V14M11,6H17V8H11V6Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Class Forms" FontSize="24" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="TitleMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card1Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.1" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card2Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.2" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card3Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.3" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card4Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.4" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card5Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.5" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card6Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.6" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</Window>