<Window x:Class="View_WPF.frmAdmin_User"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Account Information" Height="680" Width="1040"
        WindowStartupLocation="CenterScreen" Background="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="8" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#156200FF" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-150">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="40,40,60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="User Information" FontSize="32" FontWeight="Bold" Foreground="#FF1A1A1C" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Width="920" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Border Background="#FFEBEAE9" CornerRadius="23" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <!-- User ID & Password -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID (UID)" Foreground="#666" Margin="10,0,10,3"/>
                        <TextBox Text="{Binding UID}" IsEnabled="{Binding IsEditing}" Grid.Row="1" Grid.Column="0" Width="180" HorizontalAlignment="Left" Margin="10,0,0,12"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="Password" Foreground="#666" Margin="10,0,10,3"/>
                        <TextBox Text="{Binding Password}" IsEnabled="{Binding IsEditing}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Width="186" HorizontalAlignment="Left" Margin="10,0,0,12"/>

                        <!-- Phone Number & Entry Date -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone Number" Foreground="#666" Margin="10,0,10,3"/>
                        <TextBox Text="{Binding Phone}" IsEnabled="{Binding IsEditing}" Grid.Row="3" Grid.Column="0" Width="180" HorizontalAlignment="Left" Margin="10,0,10,12"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="Entry Date" Foreground="#666" Margin="10,0,10,3"/>
                        <DatePicker SelectedDate="{Binding EntryDate}" IsEnabled="{Binding IsEditing}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Width="186" HorizontalAlignment="Left" Margin="10,0,0,12"/>

                        <!-- Email Address -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="Email Address" Foreground="#666" Margin="10,0,10,3"/>
                        <TextBox Text="{Binding Email}" IsEnabled="{Binding IsEditing}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Width="386" HorizontalAlignment="Left" Margin="10,0,0,12"/>

                        <!-- Start Date, End Date, Active -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Start Date" Foreground="#666" FontSize="12" Margin="10,0,10,3"/>
                        <DatePicker SelectedDate="{Binding StartDate}" IsEnabled="{Binding IsEditing}" Grid.Row="7" Grid.Column="0" Width="180" HorizontalAlignment="Left" Margin="10,0,10,10"/>

                        <TextBlock Grid.Row="6" Grid.Column="1" Text="End Date" Foreground="#666" FontSize="12" Margin="10,0,10,3"/>
                        <DatePicker SelectedDate="{Binding EndDate}" IsEnabled="{Binding IsEditing}" Grid.Row="7" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="10,0,10,10"/>

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Active" Foreground="#666" FontSize="12" Margin="10,0,10,3"/>
                        <ComboBox SelectedValue="{Binding SelectedRole}" SelectedValuePath="Content" IsEnabled="{Binding IsEditing}" Grid.Row="7" Grid.Column="2" Width="130" HorizontalAlignment="Center" Margin="0,2,0,8">
                            <ComboBoxItem Content="Administrator"/>
                            <ComboBoxItem Content="Students"/>
                            <ComboBoxItem Content="Agent"/>
                        </ComboBox>

                        <!-- ListView with fixed Height and ScrollViewer to prevent interface stretching -->
                        <ScrollViewer Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" Grid.ColumnSpan="2" 
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                      Height="205" Margin="75,0,85,0">
                            <ListView ItemsSource="{Binding UserList}" 
                                      SelectedItem="{Binding SelectedUser}" 
                                      BorderBrush="Transparent" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="User ID (UID)" DisplayMemberBinding="{Binding UID}" Width="85"/>
                                        <GridViewColumn Header="Phone Number" DisplayMemberBinding="{Binding Phone}" Width="95"/>
                                        <GridViewColumn Header="Email Address" DisplayMemberBinding="{Binding Email}" Width="110"/>
                                        <GridViewColumn Header="Entry Date" DisplayMemberBinding="{Binding EntryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="80"/>
                                        <GridViewColumn Header="Active" DisplayMemberBinding="{Binding IsActive}" Width="50"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ScrollViewer>

                        <!-- Action Buttons (Grid Row & Column Placement without StackPanel) -->
                        <Button Command="{Binding AddCommand}" Grid.Row="8" Grid.Column="0" Height="32" Width="65" 
                                Content="ADD" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="10,5,0,0"/>

                        <Button Command="{Binding SaveCommand}" Grid.Row="8" Grid.Column="0" Height="32" Width="65" 
                                Content="SAVE" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="82,5,0,0"/>

                        <Button Command="{Binding EditCommand}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Height="32" Width="65" 
                                Content="EDIT" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="154,5,0,0"/>

                        <Button Command="{Binding DeleteCommand}" Grid.Row="8" Grid.Column="1" Height="32" Width="72" 
                                Content="DELETE" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="26,5,0,0"/>

                        <Button Command="{Binding ExitCommand}" Grid.Row="8" Grid.Column="1" Height="32" Width="72" 
                                Content="EXIT" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="107,5,0,0" Grid.ColumnSpan="2"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>