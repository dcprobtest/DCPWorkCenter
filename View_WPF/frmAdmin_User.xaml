<Window x:Class="View_WPF.frmAdmin_User"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Account Information" Height="680" Width="1040"
        WindowStartupLocation="CenterScreen" Background="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#156200FF" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-150">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="User Information" FontSize="32" FontWeight="Bold" Foreground="#FF1A1A1C" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Width="920" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Border Background="#FFEBEAE9" CornerRadius="23" Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID (UID)" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Text="{Binding UID}" Grid.Row="1" Grid.Column="0" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="Password" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Text="{Binding Password}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone Number" Foreground="#666" Margin="10,0,1,5"/>
                        <TextBox Text="{Binding Phone}" Grid.Row="3" Grid.Column="0" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="Entry Date" Foreground="#666" Margin="10,0,10,5"/>
                        <DatePicker SelectedDate="{Binding EntryDate}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,10,25"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="Email Address" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Text="{Binding Email}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Start Date" Foreground="#666" FontSize="12" Margin="10,5,10,2"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Grid.Row="7" Grid.Column="0" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="6" Grid.Column="1" Text="End Date" Foreground="#666" FontSize="12" Margin="10,5,10,2"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Grid.Row="7" Grid.Column="1" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Active" Foreground="#666" FontSize="12" Margin="10,5,10,2"/>
                        <TextBox Text="{Binding IsActive}" Grid.Row="7" Grid.Column="2" MaxLength="1" Margin="10,0,10,15"/>

                        <ListView Grid.Row="1" Grid.Column="3" Grid.RowSpan="8" 
                                  ItemsSource="{Binding UserList}" 
                                  SelectedItem="{Binding SelectedUser}" 
                                  Height="250" 
                                  Margin="10">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="User ID (UID)" DisplayMemberBinding="{Binding UID}" Width="120"/>
                                    <GridViewColumn Header="Phone Number" DisplayMemberBinding="{Binding Phone}" Width="130"/>
                                    <GridViewColumn Header="Email Address" DisplayMemberBinding="{Binding Email}" Width="150"/>
                                    <GridViewColumn Header="Entry Date" DisplayMemberBinding="{Binding EntryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                                    <GridViewColumn Header="Active" DisplayMemberBinding="{Binding IsActive}" Width="70"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Command="{Binding SaveCommand}" Grid.Row="9" Grid.Column="0" Height="35" Width="70" 
                                Content="SAVE" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="10,0,0,0"/>

                        <Button Command="{Binding EditCommand}" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Height="35" Width="70" 
                                Content="EDIT" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="90,0,0,0"/>

                        <Button Command="{Binding DeleteCommand}" Grid.Row="7" Height="35" Width="68" 
                                Content="DELETE" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="174,51,0,0" Grid.ColumnSpan="2" Grid.RowSpan="3"/>

                        <Button Command="{Binding ExitCommand}" Grid.Row="7" Grid.Column="1" Height="35" Width="74" 
                                Content="EXIT" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="56,51,0,0" Grid.RowSpan="3"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>