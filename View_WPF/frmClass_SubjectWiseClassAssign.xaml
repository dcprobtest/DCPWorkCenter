<Window x:Class="View_WPF.frmClass_SubjectWiseClassAssign"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Subject Wise Assign" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="White"
        ResizeMode="CanResize" WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="CircularCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="circle" Width="22" Height="22" Stroke="#3498DB" StrokeThickness="2" Fill="White"/>
                            <Ellipse x:Name="dot" Width="12" Height="12" Fill="#3498DB" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#5DADE2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MaxDropDownHeight" Value="400"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <Grid Margin="10,0">
                                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,5,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="True" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Text}" 
                                       IsHitTestVisible="False" Foreground="White" 
                                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                                       Margin="10,3,23,3" Visibility="Hidden"/>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="White" BorderThickness="1" BorderBrush="#5DADE2" CornerRadius="0,0,5,5"/>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Style="{StaticResource CustomComboBoxStyle}" 
                      ItemsSource="{Binding SubjectList}"
                      DisplayMemberPath="SubjectDesc" 
                      SelectedValuePath="SubjectCode"
                      Text="Subject" />

            <ComboBox Grid.Column="1" Style="{StaticResource CustomComboBoxStyle}" 
                      ItemsSource="{Binding SectionList}" 
                      DisplayMemberPath="SectionDesc"
                      SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                      Text="Section" />

            <ComboBox Grid.Column="3" Style="{StaticResource CustomComboBoxStyle}" 
                      ItemsSource="{Binding GroupList}" 
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="UID"
                      SelectedValue="{Binding UID, Mode=TwoWay}"
                      Text="Select Group/User" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#2E86C1" BorderThickness="1.5" CornerRadius="2" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <CheckBox HorizontalAlignment="Right" Margin="0,0,105,0" Style="{StaticResource CircularCheckBoxStyle}" IsEnabled="False" BorderBrush="Gray" Opacity="0.5"/>
                        <Button Content="Select All" HorizontalAlignment="Right" Background="#5DADE2" Foreground="White" Width="100" Height="30" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding ClassList}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource CircularCheckBoxStyle}" VerticalAlignment="Center"/>

                                    <Border Grid.Column="1" Background="#34495E" CornerRadius="5" Padding="10,8">
                                        <TextBlock Text="{Binding ClassContent, FallbackValue='Loading...'}" 
                                                   Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#2E86C1" BorderThickness="1.5" CornerRadius="2" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <CheckBox HorizontalAlignment="Right" Margin="0,0,105,0" Style="{StaticResource CircularCheckBoxStyle}" IsEnabled="False" Opacity="0.5"/>
                        <Button Content="Select All" HorizontalAlignment="Right" Background="#5DADE2" Foreground="White" Width="100" Height="30" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding StudentList}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource CircularCheckBoxStyle}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#A9CCE3" BorderBrush="#2E86C1" BorderThickness="1.5" CornerRadius="5" Padding="10,8">
                                        <TextBlock Text="{Binding StudentName, FallbackValue='Student Name'}" Foreground="#1B4F72" FontSize="16" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Assign" Command="{Binding SaveCommand}" Background="#5DADE2" Foreground="White" Height="35" Margin="5" FontSize="16" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="Cancel" Background="#5DADE2" Foreground="Red" Height="35" Margin="5" FontSize="16" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>