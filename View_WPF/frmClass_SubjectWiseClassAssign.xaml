<Window x:Class="View_WPF.frmClass_SubjectWiseClassAssign"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Subject Wise Assign" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="CircularCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="circle" Width="22" Height="22" Stroke="#3498DB" StrokeThickness="2" Fill="White"/>
                            <Ellipse x:Name="dot" Width="12" Height="12" Fill="#3498DB" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="circle" Property="Fill" Value="#EBF5FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0,0" EndPoint="1,1">
            <LinearGradientBrush.RelativeTransform>
                <RotateTransform x:Name="RainbowRotation" CenterX="0.5" CenterY="0.5" Angle="0"/>
            </LinearGradientBrush.RelativeTransform>
            <GradientStop Color="#FF0000" Offset="0.0"/>
            <GradientStop Color="#FFFF00" Offset="0.2"/>
            <GradientStop Color="#00FF00" Offset="0.4"/>
            <GradientStop Color="#00FFFF" Offset="0.6"/>
            <GradientStop Color="#0000FF" Offset="0.8"/>
            <GradientStop Color="#FF00FF" Offset="1.0"/>
        </LinearGradientBrush>

        <Storyboard x:Key="RainbowBorderAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RainbowRotation" 
                             Storyboard.TargetProperty="Angle" 
                             From="0" To="360" Duration="0:0:4"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource RainbowBorderAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Ellipse Fill="#20A2D9CE" Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-100,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#20FADBD8" Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-100">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Subject ▼" Background="#5DADE2" Foreground="White" Margin="5" Height="40" BorderThickness="0" FontSize="15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="1" Content="Section ▼" Background="#5DADE2" Foreground="White" Margin="5" Height="40" BorderThickness="0" FontSize="15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="2" Content="Group - 1 ▼" Background="#5DADE2" Foreground="White" Margin="5" Height="40" BorderThickness="0" FontSize="15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource RainbowBrush}" BorderThickness="2" CornerRadius="12" Background="White" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <CheckBox Style="{StaticResource CircularCheckBoxStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Button Content="Select All" HorizontalAlignment="Right" Background="#3498DB" Foreground="White" Width="90" Height="28" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ClassList}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource CircularCheckBoxStyle}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#2C3E50" CornerRadius="6" Padding="12,8">
                                            <TextBlock Text="{Binding ClassName, FallbackValue='Class Name'}" Foreground="White" FontSize="14"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" BorderBrush="{StaticResource RainbowBrush}" BorderThickness="2" CornerRadius="12" Background="White" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <CheckBox Style="{StaticResource CircularCheckBoxStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Button Content="Select All" HorizontalAlignment="Right" Background="#3498DB" Foreground="White" Width="90" Height="28" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding StudentList}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource CircularCheckBoxStyle}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#EBF5FB" BorderBrush="#AED6F1" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <TextBlock Text="{Binding StudentName, FallbackValue='Student Name'}" Foreground="#2C3E50" FontSize="14"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Margin="5" BorderBrush="{StaticResource RainbowBrush}" BorderThickness="1.5" CornerRadius="8">
                    <Button Content="Assign" Background="#2C3E50" Foreground="White" Height="40" FontSize="16" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Border>

                <Button Grid.Column="2" Content="Cancel" Margin="5" Height="40" FontSize="16" Foreground="Red" Background="Transparent" BorderBrush="Red" BorderThickness="1.5">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>