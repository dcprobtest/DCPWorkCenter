<Window x:Class="View_WPF.frm_STEM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="STEM Management" Height="650" Width="950" 
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized" 
        Background="#F5F6F7">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5D8BF4" Offset="0"/>
            <GradientStop Color="#3B5998" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ThemeButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="5" BorderThickness="1.5">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4B2B" Offset="0"/>
                                    <GradientStop Color="#2ECC71" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#667eea" Offset="0"/>
                                    <GradientStop Color="#764ba2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Border CornerRadius="15" BorderThickness="3">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF4B2B" Offset="0"/>
                    <GradientStop Color="#FFB22C" Offset="0.3"/>
                    <GradientStop Color="#2ECC71" Offset="0.6"/>
                    <GradientStop Color="#3498DB" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid Background="White" Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgSTEM" Grid.Row="0" AutoGenerateColumns="False" 
                              ItemsSource="{Binding STEMList}" 
                              SelectedItem="{Binding SelectedSTEM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              BorderBrush="#DDD" Background="White" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trans ID" Binding="{Binding TransID}" Width="80"/>
                            <DataGridTextColumn Header="Student ID" Binding="{Binding StudentUID}" Width="80"/>
                            <DataGridTextColumn Header="Year" Binding="{Binding dYear}" Width="50"/>
                            <DataGridTextColumn Header="Month" Binding="{Binding dMonth}" Width="50"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding Hours}" Width="50"/>
                            <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="60"/>
                            <DataGridTextColumn Header="SUI" Binding="{Binding SUI}" Width="60"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="70"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding Paid}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="1" Margin="0,20,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock Text="Trans ID" VerticalAlignment="Top" Margin="0,-18,0,0" Foreground="Gray" Height="34"/>
                            <TextBox x:Name="txtTransID" Text="{Binding TransID, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalAlignment="Bottom" BorderBrush="#DDD" IsReadOnly="True"/>
                        </Grid>

                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Student UID" VerticalAlignment="Top" Margin="0,-18,0,0" Foreground="Gray" Height="34"/>
                            <TextBox x:Name="txtStudentUID" Text="{Binding StudentUID, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalAlignment="Bottom" BorderBrush="#DDD"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="ADD" Command="{Binding AddCommand}" Grid.Column="0" Margin="2" Height="35" Foreground="White" FontWeight="Bold" Style="{StaticResource ThemeButtonStyle}"/>
                        <Button Content="SAVE" Command="{Binding SaveCommand}" Grid.Column="1" Margin="2" Height="35" Foreground="White" FontWeight="Bold" Style="{StaticResource ThemeButtonStyle}"/>
                        <Button Content="DELETE" Command="{Binding DeleteCommand}" Grid.Column="2" Margin="2" Height="35" Foreground="White" FontWeight="Bold" Style="{StaticResource ThemeButtonStyle}"/>
                        <Button Content="EDIT" Command="{Binding EditCommand}" Grid.Column="3" Margin="2" Height="35" Foreground="White" FontWeight="Bold" Style="{StaticResource ThemeButtonStyle}"/>
                        <Button Content="EXIT" x:Name="btnExit" Click="btnExit_Click" Grid.Column="4" Margin="2" Height="35" Foreground="White" FontWeight="Bold" Style="{StaticResource ThemeButtonStyle}"/>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1" Margin="10,20,20,20" Background="#F9F9F9">
                    <Border CornerRadius="10" Background="White" Margin="5" Visibility="{Binding IsInputVisible, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="Admin ID (Entry By)" Foreground="Gray" Margin="0,0,0,35"/>
                                <TextBox x:Name="txtAdminUID" Text="{Binding AdminID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalAlignment="Top" Margin="0,20,0,0" BorderBrush="#DDD" IsReadOnly="True"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <CheckBox Content="Is Active" IsChecked="{Binding IsActive}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Button x:Name="btnActiveNow" Content="Active Now" HorizontalAlignment="Right" Width="120" Height="35" Foreground="White" FontWeight="Bold">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3498DB" Offset="0"/>
                                            <GradientStop Color="#9B59B6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </Grid>

                            <Border Grid.Row="2" Margin="0,20,0,0" BorderBrush="#EEE" BorderThickness="1" CornerRadius="5">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,5">
                                        <TextBlock Text="Year" Foreground="Gray"/>
                                        <TextBox x:Name="txtYear" Text="{Binding dYear}" Margin="60,0,0,0" Height="25" Background="#F0F0F0" BorderThickness="0"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,5">
                                        <TextBlock Text="Month" Foreground="Gray"/>
                                        <TextBox x:Name="txtMonth" Text="{Binding dMonth}" Margin="60,0,0,0" Height="25" Background="#F0F0F0" BorderThickness="0"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,5">
                                        <TextBlock Text="Pay Date" Foreground="Gray"/>
                                        <DatePicker x:Name="dtpPayDate" SelectedDate="{Binding PayDate}" Margin="60,0,0,0" Height="25"/>
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,5">
                                        <TextBlock Text="Hours" Foreground="Gray"/>
                                        <TextBox x:Name="txtHours" Text="{Binding Hours}" Margin="60,0,0,0" Height="25" Background="#F0F0F0" BorderThickness="0"/>
                                    </Grid>
                                    <Grid Grid.Row="4" Margin="0,5">
                                        <TextBlock Text="Rate" Foreground="Gray"/>
                                        <TextBox x:Name="txtRate" Text="{Binding Rate}" Margin="60,0,0,0" Height="25" Background="#F0F0F0" BorderThickness="0"/>
                                    </Grid>
                                    <Grid Grid.Row="5" Margin="0,5">
                                        <TextBlock Text="SUI" Foreground="Gray"/>
                                        <TextBox x:Name="txtSUI" Text="{Binding SUI}" Margin="60,0,0,0" Height="25" Background="#F0F0F0" BorderThickness="0"/>
                                    </Grid>
                                    <Grid Grid.Row="6" Margin="0,5">
                                        <TextBlock Text="Emp Tax" Foreground="Gray"/>
                                        <TextBox x:Name="txtEmpTax" Text="{Binding EmpTax}" Margin="60,0,0,0" Height="25" Background="#F0F0F0" BorderThickness="0"/>
                                    </Grid>
                                    <Grid Grid.Row="7" Margin="0,5">
                                        <TextBlock Text="Paid" Foreground="Gray"/>
                                        <TextBox x:Name="txtPaid" Text="{Binding Paid}" Margin="60,0,0,0" Height="25" Background="#F0F0F0" BorderThickness="0"/>
                                    </Grid>
                                    <Grid Grid.Row="8" Margin="0,5">
                                        <TextBlock Text="Total" Foreground="Gray" FontWeight="Bold"/>
                                        <TextBox x:Name="txtTotal" Text="{Binding Total}" Margin="60,0,0,0" Height="25" Background="#E8F4FD" BorderThickness="0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>