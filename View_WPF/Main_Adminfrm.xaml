<Window x:Class="View_WPF.Main_Adminfrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrative Management" 
        Height="850" Width="1050" 
        WindowState="Maximized" 
        Background="White">

    <Window.Resources>
        <Style x:Key="OptionCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CardContainer" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="GradientBorder" CornerRadius="25" Padding="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.25"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFF" Offset="0.75"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#22FF5722" Width="1000" Height="1000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-300,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#1500C853" Width="1400" Height="1200" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-300">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Administrative Forms" FontSize="56" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,60">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleMove" Y="40"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="450"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>

                <Button Grid.Column="0" Grid.Row="0" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card1Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="80" Width="80" VerticalAlignment="Top" Margin="138,35,162,0">
                            <Path Fill="#2196F3" Data="M12,18.54L19.37,12.8L21,14.07L12,21.07L3,14.07L4.62,12.81L12,18.54M12,16L3,9L12,2L21,9L12,16M12,4.53L6.26,9L12,13.47L17.74,9L12,4.53Z" Stretch="Fill" Width="59" Height="64"/>
                        </Viewbox>
                        <TextBlock Text="Department" FontSize="28" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="101,125,0,0" Grid.RowSpan="2"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="0" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card2Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Height="80" Width="80" VerticalAlignment="Top" Margin="148,39,152,0">
                            <Path Fill="#E91E63" Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.33 4,18V20H20V18C20,15.67 14.67,14 12,14Z" Height="24" Stretch="Fill" Width="24"/>
                        </Viewbox>
                        <TextBlock Text="Designation" FontSize="28" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,123,0,0" Grid.RowSpan="2"/>
                    </Grid>
                </Button>

                <Button Grid.Column="0" Grid.Row="1" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card3Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="80" Width="80" VerticalAlignment="Top" Margin="132,31,168,0">
                            <Path Fill="#FF9800" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                        </Viewbox>
                        <TextBlock Text="Document Info" FontSize="28" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="88,123,0,0" Grid.RowSpan="2"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="1" Margin="25" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card4Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="380" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="80" Width="80" VerticalAlignment="Bottom">
                            <Path Fill="#673AB7" Data="M13,20.08L12,20L9,20L6,20L5,20.08C3.85,20.47 3,21.13 3,22V24H21V22C21,21.13 20.15,20.47 19,20.08M12,4L15,4L15,18L12,18L9,18L9,4L12,4M12,0L7,0V2H17V0L12,0Z"/>
                        </Viewbox>
                        <TextBlock Text="Employee Info" FontSize="28" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,127,0,0" Grid.RowSpan="2"/>
                    </Grid>
                </Button>

                <Button Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="25" Width="500" Style="{StaticResource OptionCardStyle}" HorizontalAlignment="Center">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card5Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid Width="450" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="80" Width="80" VerticalAlignment="Bottom">
                            <Path Fill="#009688" Data="M5,4H19A2,2 0 0,1 21,6V18A2,2 0 0,1 19,20H5A2,2 0 0,1 3,18V6A2,2 0 0,1 5,4M5,8V12H11V8H5M13,8V12H19V8H13M5,14V18H11V14H5M13,14V18H19V14H13Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="User Table" FontSize="28" FontWeight="SemiBold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="TitleMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card1Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.1" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card2Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.2" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card3Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.3" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card4Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.4" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card5Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.5" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</Window>