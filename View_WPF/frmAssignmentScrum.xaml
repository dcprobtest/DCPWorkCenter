<Window x:Class="View_WPF.frmAssignmentScrum"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="Assignment Scrum Information" Height="780" Width="780"
        WindowStartupLocation="CenterScreen" Background="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,10,15"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,10,15"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="10,0,10,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SmallFieldStyle" TargetType="FrameworkElement">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="140"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#15007AFF" Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-250,-250,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
            <Grid Margin="30,40,30,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Assignment Scrum Management" FontSize="32" FontWeight="Bold" Foreground="#FF0A0909" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <Border Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                    <Border.Background>
                        <LinearGradientBrush x:Name="MainBorderBrush" StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                            <GradientStop Color="#00FF00" Offset="0.4"/>
                            <GradientStop Color="#00FFFF" Offset="0.6"/>
                            <GradientStop Color="#0000FF" Offset="0.8"/>
                            <GradientStop Color="#FF00FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="MainBorderRotate" 
                                                     Storyboard.TargetProperty="Angle" 
                                                     From="0" To="360" 
                                                     Duration="0:0:12" 
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Border Background="#FFEBEAE9" CornerRadius="23" Padding="25" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Assign ID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableAssignIDs}" 
                                      SelectedValue="{Binding Scrum.AssignID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Style="{StaticResource SmallFieldStyle}" Grid.Row="1" Grid.Column="0"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Scrum ID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableScrumIDs}" 
                                      SelectedValue="{Binding Scrum.ScrumID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Style="{StaticResource SmallFieldStyle}" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Assign By UID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Scrum.AssignByUID, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" MaxLength="6" Style="{StaticResource SmallFieldStyle}" Grid.Row="3" Grid.Column="0"/>

                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Assign For UID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableUsers}" 
                                      DisplayMemberPath="DisplayText"
                                      SelectedValuePath="UID"
                                      SelectedValue="{Binding Scrum.AssignForUID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      Style="{StaticResource SmallFieldStyle}" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="Assign By Description" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Scrum.AssignByDesc, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,20,15"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text="Assign For Description" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Scrum.AssignForDesc, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,20,15" TextChanged="TextBox_TextChanged"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Start Status" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Scrum.StartStatus, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Style="{StaticResource SmallFieldStyle}" Grid.Row="9" Grid.Column="0"/>

                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Start Date" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding Scrum.StartDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallFieldStyle}" Grid.Row="9" Grid.Column="1"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Progress Status" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Scrum.ProgressStatus, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Style="{StaticResource SmallFieldStyle}" Grid.Row="11" Grid.Column="0"/>

                            <TextBlock Grid.Row="10" Grid.Column="1" Text="Progress Date" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding Scrum.ProgressDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallFieldStyle}" Grid.Row="11" Grid.Column="1"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Complete Status" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Scrum.CompleteStatus, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Style="{StaticResource SmallFieldStyle}" Grid.Row="13" Grid.Column="0"/>

                            <TextBlock Grid.Row="12" Grid.Column="1" Text="Complete Date" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding Scrum.CompleteDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SmallFieldStyle}" Grid.Row="13" Grid.Column="1"/>

                            <CheckBox IsChecked="{Binding IsActivated}" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,8,10,15" VerticalAlignment="Top">
                                <TextBlock Text="Activate Assignment" Foreground="Black" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </CheckBox>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Scrum Assignment List" Foreground="#555555" FontWeight="SemiBold" Margin="5,0,0,5"/>

                            <Border Grid.Row="1" Grid.RowSpan="13" Grid.Column="3" Margin="5,0,10,15" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="White">
                                <ListBox ItemsSource="{Binding ScrumList}" SelectedItem="{Binding SelectedScrum}" Background="Transparent" BorderThickness="0" Margin="5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4">
                                                <TextBlock Text="{Binding AssignForDesc}" FontSize="14" Foreground="Black" Margin="5"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Button Command="{Binding AddCommand}" Content="ADD" Style="{StaticResource RainbowButtonStyle}" Grid.Row="15" Grid.Column="0" Height="45" Margin="10,10,5,0"/>
                            <Button Command="{Binding SaveCommand}" Content="SAVE" Style="{StaticResource RainbowButtonStyle}" Grid.Row="15" Grid.Column="1" Height="45" Margin="5,10,10,0"/>
                            <Button Command="{Binding EditCommand}" Content="EDIT" Style="{StaticResource RainbowButtonStyle}" Grid.Row="15" Grid.Column="2" HorizontalAlignment="Left" Width="150" Height="45" Margin="4,10,0,0" Grid.ColumnSpan="2"/>
                            <Button Command="{Binding ExitCommand}" Content="EXIT" Style="{StaticResource RainbowButtonStyle}" Grid.Row="15" Grid.Column="3" HorizontalAlignment="Right" Width="150" Height="45" Margin="5,10,10,0"/>

                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>