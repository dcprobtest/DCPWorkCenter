<Window x:Class="View_WPF.frm_OfferLetter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offer Letter Generation" Height="850" Width="1200" 
        Background="#F0F2F5" WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="1000"
        WindowState="Minimized">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="25" BorderBrush="#C0C0C0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="User ID:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="" VerticalAlignment="Center" Margin="5,0,20,0"/>

                        <Label Grid.Column="2" Content="User Name:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Height="32" VerticalContentAlignment="Center" IsEditable="True" IsReadOnly="True" Text="Document Type" Margin="0,0,125,0">
                            <ComboBoxItem Content="CPT"/>
                            <ComboBoxItem Content="OPT"/>
                            <ComboBoxItem Content="STEM OPT"/>
                            <ComboBoxItem Content="Resume"/>
                            <ComboBoxItem Content="Offer Letter"/>
                        </ComboBox>

                        <ComboBox Height="32" VerticalContentAlignment="Center" IsEditable="True" Text="Candidate ID" Margin="163,0,0,0" HorizontalAlignment="Left" Width="94" Grid.ColumnSpan="2"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="Job Designation:" Foreground="#555"/>
                        <TextBox Grid.Row="1" Height="32" VerticalContentAlignment="Center" Margin="0,0,291,0"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Content="Job Responsibility:" Foreground="#555"/>
                        <TextBox Grid.Row="1" MinHeight="70" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Job Start:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,0,92,0"/>

                        <Label Grid.Column="1" Content="Job End:" VerticalAlignment="Center" Margin="174,0,5,0" Grid.ColumnSpan="2"/>
                        <DatePicker Grid.Column="3" Height="32" VerticalContentAlignment="Center" Margin="0,0,68,0"/>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Height="32" VerticalContentAlignment="Center" IsEditable="True" IsReadOnly="True" Text="Hourly Rate" Margin="0,0,100,0">
                            <ComboBoxItem Content="10-20$"/>
                            <ComboBoxItem Content="20-30$"/>
                            <ComboBoxItem Content="30-40$"/>
                        </ComboBox>

                        <ComboBox Height="32" VerticalContentAlignment="Center" IsEditable="True" IsReadOnly="True" Text="Weekly Hours" Margin="134,0,166,0" Grid.ColumnSpan="2">
                            <ComboBoxItem Content="20-30"/>
                            <ComboBoxItem Content="30-40"/>
                            <ComboBoxItem Content="40+"/>
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,10,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="Email:" Foreground="#555" Padding="0,0,0,5"/>
                            <Button Grid.Row="1" Content="Email" Height="30" Width="100" HorizontalAlignment="Left" 
                                    Background="#E8E8E8" Click="EmailButton_Click" Cursor="Hand"/>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="Cc Email:" Foreground="#555" Padding="0,0,0,5"/>
                            <Button Grid.Row="1" Content="Email" Height="30" Width="100" HorizontalAlignment="Left" 
                                    Background="#E8E8E8" Click="EmailButton_Click" Cursor="Hand"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                <Button Content="Create Document" Background="#D6DBDF" Foreground="Blue" 
                        FontSize="20" FontWeight="Bold" Width="208" BorderBrush="#AAA" HorizontalAlignment="Center" Margin="0,9,0,9">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="15"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>