<Window x:Class="View_WPF.frmClassWiseExam"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="frmClassWiseExam" Height="550" Width="800">
    <Grid>
        <ComboBox x:Name="cmdSectionID" HorizontalAlignment="Left" Margin="58,53,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBlock x:Name="txtMCQID" Text="MCQID" HorizontalAlignment="Left" Margin="58,88,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Height="19" Width="112"/>
        <Button x:Name="btnCreateMCQ" Content="Create MCQ" HorizontalAlignment="Left" Height="25" Margin="58,10,0,0" VerticalAlignment="Top" Width="120"/>
        <DatePicker x:Name="dtpEntryDate" HorizontalAlignment="Left" Margin="58,125,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtQuestion" HorizontalAlignment="Left" Height="54" Margin="58,163,0,0" TextWrapping="Wrap" Text="Question" VerticalAlignment="Top" Width="454"/>
        <TextBox x:Name="txtAns1" HorizontalAlignment="Left" Height="53" Margin="58,231,0,0" TextWrapping="Wrap" Text="Ans1" VerticalAlignment="Top" Width="454"/>
        <TextBox x:Name="txtAns2" HorizontalAlignment="Left" Height="53" Margin="58,291,0,0" TextWrapping="Wrap" Text="Ans2" VerticalAlignment="Top" Width="454"/>
        <TextBox x:Name="txtAns3" HorizontalAlignment="Left" Height="53" Margin="58,414,0,0" TextWrapping="Wrap" Text="Ans3" VerticalAlignment="Top" Width="454"/>
        <TextBox x:Name="txtAns4" HorizontalAlignment="Left" Height="53" Margin="58,352,0,0" TextWrapping="Wrap" Text="Ans4" VerticalAlignment="Top" Width="454"/>
        <ComboBox x:Name="cmbRightAns" HorizontalAlignment="Left" Margin="58,481,0,0" VerticalAlignment="Top" Width="51" Height="33"/>
        <ListBox x:Name="listBox" HorizontalAlignment="Left" Height="293" Margin="548,163,0,0" VerticalAlignment="Top" Width="176" d:ItemsSource="{d:SampleData ItemCount=5}"/>

    </Grid>
</Window>
