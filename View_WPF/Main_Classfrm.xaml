<Window x:Class="View_WPF.Main_Classfrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Course &amp; Content Management" 
        Height="850" Width="1050" 
        WindowState="Maximized" 
        Background="White">

    <Window.Resources>
        <Style x:Key="OptionCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CardContainer" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="GradientBorder" CornerRadius="25" Padding="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#0072FF" Offset="0.0"/>
                                        <GradientStop Color="#00C6FF" Offset="0.25"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#FF00CC" Offset="0.75"/>
                                        <GradientStop Color="#333399" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="22">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#152196F3" Width="1200" Height="1200" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-400,-200,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#109C27B0" Width="1000" Height="1000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-300">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Course Content Management" FontSize="52" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,50">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleMove" Y="30"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <Button Grid.Column="0" Grid.Row="0" Margin="15" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card1Move" Y="80"/>
                    </Button.RenderTransform>
                    <Grid Width="350" Height="160">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="60" VerticalAlignment="Bottom">
                            <Path Fill="#4CAF50" Data="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Course Module" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="0" Margin="15" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card2Move" Y="80"/>
                    </Button.RenderTransform>
                    <Grid Width="350" Height="160">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="60" VerticalAlignment="Bottom">
                            <Path Fill="#FF5722" Data="M18,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V4A2,2 0 0,0 18,2M10,4H14V6H10V4M18,20H6V18H18V20M18,16H6V4H8V16H18V16Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Course Subject" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                </Button>

                <Button Grid.Column="0" Grid.Row="1" Margin="15" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card3Move" Y="80"/>
                    </Button.RenderTransform>
                    <Grid Width="350" Height="160">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="60" VerticalAlignment="Bottom">
                            <Path Fill="#9C27B0" Data="M3,5V19L11,12M13,19V5L21,12"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Subject Section" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="1" Margin="15" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card4Move" Y="80"/>
                    </Button.RenderTransform>
                    <Grid Width="350" Height="160">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="60" VerticalAlignment="Bottom">
                            <Path Fill="#2196F3" Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Class Video Text" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                </Button>

                <Button Grid.Column="0" Grid.Row="2" Margin="15" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card5Move" Y="80"/>
                    </Button.RenderTransform>
                    <Grid Width="350" Height="160">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="60" VerticalAlignment="Bottom">
                            <Path Fill="#FF9800" Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10H6M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Section Assign" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="2" Margin="15" Style="{StaticResource OptionCardStyle}">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card6Move" Y="80"/>
                    </Button.RenderTransform>
                    <Grid Width="350" Height="160">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="60" VerticalAlignment="Bottom">
                            <Path Fill="#E91E63" Data="M9,16V10H5L12,3L19,10H15V16H9M5,18H19V20H5V18Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Video Upload" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="TitleMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card1Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.1" Duration="0:0:0.7"/>
                        <DoubleAnimation Storyboard.TargetName="Card2Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.2" Duration="0:0:0.7"/>
                        <DoubleAnimation Storyboard.TargetName="Card3Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.3" Duration="0:0:0.7"/>
                        <DoubleAnimation Storyboard.TargetName="Card4Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.4" Duration="0:0:0.7"/>
                        <DoubleAnimation Storyboard.TargetName="Card5Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.5" Duration="0:0:0.7"/>
                        <DoubleAnimation Storyboard.TargetName="Card6Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.6" Duration="0:0:0.7"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</Window>