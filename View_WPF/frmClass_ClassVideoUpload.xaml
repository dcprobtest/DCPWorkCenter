<Window x:Class="View_WPF.frmClass_ClassVideoUpload"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Video Upload" 
        Height="650" Width="800"
        WindowStartupLocation="CenterScreen" 
        Background="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0B0D" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#1500D0FF" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Class Video Upload" FontSize="32" FontWeight="Bold" Foreground="#FF1A1A1C" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Width="650" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Border Background="#FFEBEAE9" CornerRadius="23" Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Class ID" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Section ID" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Subject Code" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Course Code" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="10,0,10,15"/>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Video File Path" Foreground="#666" Margin="10,0,10,5"/>
                        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="10,0,10,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Background="#F5F5F5" Text="No file selected..."/>
                            <Button Grid.Column="1" Content="Browse" Width="80" Margin="10,0,0,0" Background="#333" Foreground="White" Padding="5"/>
                        </Grid>

                        <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Margin="10,10,0,20" VerticalAlignment="Center">
                            <TextBlock Text="Activate Video for Class" Foreground="Black" FontSize="16" Margin="10,0,0,0"/>
                        </CheckBox>

                        <Button Grid.Row="7" Grid.ColumnSpan="2" Height="50" Width="280" 
                                Content="UPLOAD &amp; SAVE VIDEO" 
                                Style="{StaticResource RainbowButtonStyle}" 
                                HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>