<Window x:Class="View_WPF.frmAdmin_DocInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:View_WPF.ModelView_WPF;assembly=ModelView_WPF" 
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="DCP Document Manager" Height="650" Width="1050" 
        Background="White" 
        WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="130"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Margin="10,5,10,5">
                <TextBlock Text="DCP Document Manager" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" Foreground="White" FontSize="26" FontWeight="Bold"/>
            </Border>

            <Grid Grid.Row="1" Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="5,10,5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="UID: " FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#2C3E50"/>
                        <TextBlock Grid.Column="1" Text="{Binding UID}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="Black" Margin="0,0,25,0"/>

                        <TextBlock Grid.Column="2" Text="Emp Name: " FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#2C3E50"/>
                        <TextBlock Grid.Column="3" Text="{Binding EmployeeName}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="Black"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="cmbDocType" Grid.Column="0" Height="38" Width="150" HorizontalAlignment="Left" Margin="2,0,0,0" 
                                  Background="#E0E0E0" VerticalContentAlignment="Center" 
                                  IsEditable="True" IsReadOnly="True" Text="Document Type"
                                  FontWeight="Bold" FontSize="14"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding SelectedDocType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="Driving Licence"/>
                            <ComboBoxItem Content="SSN"/>
                            <ComboBoxItem Content="I-20"/>
                            <ComboBoxItem Content="I-9"/>
                            <ComboBoxItem Content="EAD"/>
                            <ComboBoxItem Content="I-983"/>
                            <ComboBoxItem Content="Certificate"/>
                            <ComboBoxItem Content="Passport"/>
                            <ComboBoxItem Content="Resume"/>
                            <ComboBoxItem Content="Picture"/>
                            <ComboBoxItem Content="Offer Letter"/>
                            <ComboBoxItem Content="Visa"/>
                        </ComboBox>

                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PlusButton" Grid.Column="0" Width="38" Height="38" Margin="5,0" Cursor="Hand" 
                                    Command="{Binding OpenContextMenuCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="#4CAF50" Stroke="#2E7D32" StrokeThickness="1"/>
                                                        <Ellipse Margin="2">
                                                            <Ellipse.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#A5D6A7" Offset="0"/>
                                                                    <GradientStop Color="#4CAF50" Offset="0.5"/>
                                                                    <GradientStop Color="#2E7D32" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock Text="+" Foreground="White" FontSize="26" FontWeight="Bold" 
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="CPT" Command="{Binding ShowPopupCommand}" CommandParameter="CPT Information"/>
                                        <MenuItem Header="OPT" Command="{Binding ShowPopupCommand}" CommandParameter="OPT Information"/>
                                        <MenuItem Header="STEM OPT" Command="{Binding ShowPopupCommand}" CommandParameter="STEM OPT Information"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button x:Name="UploadButton" Grid.Column="1" Width="38" Height="38" Margin="5,0" Cursor="Hand"
                                    Command="{Binding AddCommand}" 
                                    CommandParameter="{Binding SelectedValue, ElementName=cmbDocType}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="#4CAF50" Stroke="#2E7D32" StrokeThickness="1"/>
                                            <Ellipse Margin="2">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#A5D6A7" Offset="0"/>
                                                        <GradientStop Color="#4CAF50" Offset="0.5"/>
                                                        <GradientStop Color="#2E7D32" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Path Data="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z" Fill="White" 
                                                  Width="18" Height="18" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Width="38" Height="38" Margin="5,0" Cursor="Hand" Command="{Binding DownloadCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="#4CAF50" Stroke="#2E7D32" StrokeThickness="1"/>
                                            <Ellipse Margin="2">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#A5D6A7" Offset="0"/>
                                                        <GradientStop Color="#4CAF50" Offset="0.5"/>
                                                        <GradientStop Color="#2E7D32" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Fill="White" 
                                                  Width="18" Height="18" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Start Date: " FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StartDate, StringFormat='dd-MM-yyyy'}" Foreground="Blue" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="End Date: " FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding EndDate, StringFormat='dd-MM-yyyy'}" Foreground="Red" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="1" Background="White">
                    <ListView ItemsSource="{Binding Documents}" 
                              SelectedItem="{Binding SelectedDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9F9" BorderBrush="#DCDDE1" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Type}" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>

                                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding EntryDate, StringFormat=Entry: {0:dd-MM-yyyy}}" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Text="{Binding CustomEndDate, StringFormat=End: {0:dd-MM-yyyy}}" FontSize="11" Foreground="#E74C3C" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Border Grid.Column="1" Background="#EAECEE" Margin="15,0,0,0" BorderBrush="#BDC3C7" BorderThickness="1">
                    <ContentControl Content="{Binding SelectedDocument.Path}">
                        <ContentControl.ContentTemplateSelector>
                            <local:DocumentTemplateSelector>
                                <local:DocumentTemplateSelector.ImageTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" Stretch="Uniform" Margin="5"/>
                                    </DataTemplate>
                                </local:DocumentTemplateSelector.ImageTemplate>

                                <local:DocumentTemplateSelector.BrowserTemplate>
                                    <DataTemplate>
                                        <WebBrowser local:BrowserBehavior.Html="{Binding}" />
                                    </DataTemplate>
                                </local:DocumentTemplateSelector.BrowserTemplate>
                            </local:DocumentTemplateSelector>
                        </ContentControl.ContentTemplateSelector>
                    </ContentControl>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="25,0,25,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#2ECC71" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50">
                        <Run Text="Server Status:"/>
                        <Run Text=" Online" Foreground="#27AE60" FontWeight="Bold"/>
                        <Run Text="{Binding ServerStatus, StringFormat=' (Connected to {0})'}" />
                    </TextBlock>
                </Grid>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Back" Width="120" Height="40" Margin="0,0,10,0"
                            Background="#34495E" Foreground="White" FontSize="18" FontWeight="Bold" 
                            Command="{Binding BackCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="1" Content="Logout" Width="120" Height="40" 
                            Background="#2C3E50" Foreground="White" FontSize="18" FontWeight="Bold" 
                            Command="{Binding LogoutCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <Grid Background="#66000000" Visibility="{Binding IsPopupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="450" Height="480" Background="White" CornerRadius="15" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding PopupTitle}" FontSize="24" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#2C3E50"/>

                    <TextBlock Grid.Row="1" Text="Employer Name" Margin="0,5" FontWeight="SemiBold" Foreground="#34495E"/>

                    <TextBox Grid.Row="2" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,20" Padding="5,0"
                             Text="{Binding PopupEmployerName, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" Background="#F0F0F0"/>

                    <Grid Grid.Row="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Start Date" Margin="0,5" FontWeight="SemiBold" Foreground="#34495E"/>
                            <DatePicker Grid.Row="1" Height="38" SelectedDate="{Binding PopupStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="End Date" Margin="0,5" FontWeight="SemiBold" Foreground="#34495E"/>
                            <DatePicker Grid.Row="1" Height="38" SelectedDate="{Binding PopupEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Grid>

                    <Button Grid.Row="4" Content="📁 Click to Upload Document" Height="50" Background="#F8F9F9" Cursor="Hand" 
                            BorderBrush="#DCDDE1" BorderThickness="1" Foreground="#2C3E50" FontWeight="SemiBold"
                            Command="{Binding UploadInPopupCommand}"/>

                    <Grid Grid.Row="6" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Cancel" Grid.Column="0" Height="45" Margin="0,0,8,0" 
                                Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14"
                                Command="{Binding ClosePopupCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Save Data" Grid.Column="1" Height="45" Margin="8,0,0,0" 
                                Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="14"
                                Command="{Binding SavePopupDataCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>