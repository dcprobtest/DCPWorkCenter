<Window x:Class="View_WPF.frmClass_ClassSubject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModelView_WPF;assembly=ModelView_WPF"
        Title="Class Subject Management" 
        Height="720" Width="1050"
        WindowStartupLocation="CenterScreen" 
        Background="#F4F7F9"
        AllowsTransparency="False" 
        WindowStyle="SingleBorderWindow"
        x:Name="WindowSubjectManagement">

    <Window.DataContext>
        <vm:ClassSubjectViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CRUDButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}">
            <Setter Property="Background" Value="#E11D48"/>
        </Style>
        <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
        </Style>
        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <Style x:Key="ActivateButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="RainbowBorder" CornerRadius="6" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="Rotate" CenterX="0.5" CenterY="0.5" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                                        <GradientStop Color="#00FF00" Offset="0.4"/>
                                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                                        <GradientStop Color="#0000FF" Offset="0.8"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#F3F4F6" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Rotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.RenderTransform>
        <TranslateTransform x:Name="WindowTransform" Y="0"/>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="WindowTransform" Storyboard.TargetProperty="Y" From="800" To="0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="MainGrid" Margin="15">
        <Border x:Name="OuterBorder" CornerRadius="20" Padding="2.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#6366F1" Offset="0.0"/>
                    <GradientStop Color="#A855F7" Offset="0.5"/>
                    <GradientStop Color="#6366F1" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:15" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Border x:Name="ContentBorder" Background="White" CornerRadius="18" Padding="20">
                <Grid x:Name="InternalLayout">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="LeftPanel" Grid.Column="0" Margin="0,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Class Subject Directory" FontSize="22" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

                        <DataGrid x:Name="dgSubjectList" Grid.Row="1" 
                                  ItemsSource="{Binding SubjectList}" 
                                  SelectedItem="{Binding SelectedSubject, UpdateSourceTrigger=PropertyChanged}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="38"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Subject Code" Binding="{Binding SubjectCode}" Width="150" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Subject Desc" Binding="{Binding SubjectDesc}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid x:Name="InputForm" Grid.Row="2" Margin="0,15,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Subject Code" Foreground="#6B7280" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtSubjectCode" Grid.Row="1" 
                                     Text="{Binding CurrentSubject.SubjectCode, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" FontWeight="Bold"/>

                            <TextBlock Grid.Column="1" Text="Subject Description" Foreground="#6B7280" FontSize="11" Margin="10,0,0,5"/>
                            <TextBox x:Name="txtSubjectDesc" Grid.Row="1" Grid.Column="1" 
                                     Text="{Binding CurrentSubject.SubjectDesc, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="40" Margin="10,0,0,0"/>
                        </Grid>

                        <UniformGrid x:Name="ugActionButtons" Grid.Row="3" Columns="5" Height="45">
                            <Button Content="ADD" Style="{StaticResource AddButtonStyle}" Margin="2" Command="{Binding AddCommand}"/>
                            <Button Content="SAVE" Style="{StaticResource SaveButtonStyle}" Margin="2" Command="{Binding SaveCommand}"/>
                            <Button Content="DELETE" Style="{StaticResource DeleteButtonStyle}" Margin="2" Command="{Binding DeleteCommand}"/>
                            <Button Content="EDIT" Style="{StaticResource EditButtonStyle}" Margin="2" Command="{Binding EditCommand}"/>
                            <Button Content="EXIT" Style="{StaticResource ExitButtonStyle}" Margin="2" Command="{Binding ExitCommand}"/>
                        </UniformGrid>
                    </Grid>

                    <Border x:Name="RightSidebar" Grid.Column="1" Background="#F9FAFB" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock Text="Entry By (User UID)" Foreground="#6B7280" FontSize="11"/>
                                <TextBox Text="{Binding CurrentSubject.EntryByUid, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,18,0,0" Height="35" IsReadOnly="True" Background="#F3F4F6" BorderThickness="0"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsActiveChecked}" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Active" FontWeight="SemiBold" Foreground="#374151"/>
                                </CheckBox>
                                <Button Content="Update Status" Grid.Column="1" 
                                        Style="{StaticResource ActivateButtonStyle}" Height="35" 
                                        Command="{Binding ToggleStatusCommand}"/>
                            </Grid>

                            <Expander Grid.Row="2" Header="Scheduling Timeline" Foreground="#6366F1" FontWeight="SemiBold" IsExpanded="True">
                                <Border Background="White" CornerRadius="10" Padding="15" Margin="0,10,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Entry Date" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="1" Text="{Binding CurrentSubject.EntryDate, StringFormat='dd-MMM-yyyy', Mode=OneWay}" IsReadOnly="True" Background="#FAFAFA" Margin="0,2,0,10"/>

                                        <TextBlock Grid.Row="2" Text="Start Date" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="3" Text="{Binding CurrentSubject.StartDate, StringFormat='dd-MMM-yyyy', Mode=OneWay}" IsReadOnly="True" Background="#FAFAFA" Margin="0,2,0,10"/>

                                        <TextBlock Grid.Row="4" Text="End Date" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="5" Text="{Binding CurrentSubject.EndDate, StringFormat='dd-MMM-yyyy', Mode=OneWay}" IsReadOnly="True" Background="#FAFAFA" Margin="0,2,0,10"/>

                                        <TextBlock Grid.Row="6" Text="Last Update" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="7" Text="{Binding CurrentSubject.LastUpdate, StringFormat='dd-MMM-yyyy', Mode=OneWay}" IsReadOnly="True" Background="#FAFAFA"/>
                                    </Grid>
                                </Border>
                            </Expander>

                            <TextBlock Text="DCP Work Center System" Grid.Row="3" Foreground="#D1D5DB" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>