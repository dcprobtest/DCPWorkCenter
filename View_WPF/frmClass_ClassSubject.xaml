<Window x:Class="View_WPF.frmClass_ClassSubject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModelView_WPF;assembly=ModelView_WPF"
        Title="Class Subject Management" 
        Height="780" Width="600"
        WindowStartupLocation="CenterScreen" 
        Background="#F4F7F9"
        AllowsTransparency="False" 
        WindowStyle="SingleBorderWindow"
        x:Name="WindowSubjectManagement">

    <Window.DataContext>
        <vm:ClassSubjectViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CRUDButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#DADCE0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}"/>
        <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}"/>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}"/>
        <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}"/>
        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource CRUDButtonStyle}"/>
    </Window.Resources>

    <Window.RenderTransform>
        <TranslateTransform x:Name="WindowTransform" Y="0"/>
    </Window.RenderTransform>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="WindowTransform" Storyboard.TargetProperty="Y" From="800" To="0" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="MainGrid" Margin="15">
        <Border x:Name="OuterBorder" CornerRadius="20" Padding="2.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#6366F1" Offset="0.0"/>
                    <GradientStop Color="#A855F7" Offset="0.5"/>
                    <GradientStop Color="#6366F1" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:15" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Border x:Name="ContentBorder" Background="White" CornerRadius="18" Padding="20">
                <Grid x:Name="InternalLayout">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Class Subject Directory" FontSize="22" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>

                    <Expander x:Name="expTimeline" Grid.Row="1" Header="Others info" Foreground="#8B5CF6" FontWeight="SemiBold" IsExpanded="False" Margin="0,0,0,15">
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,10,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Entry By UID" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtEntryByUID" Grid.Row="1" Style="{StaticResource ModernTextBox}" FontWeight="Bold" Margin="0,0,387,10"
                                         IsReadOnly="True"
                                         Text="{Binding CurrentSubject.EntryByUid}"/>

                                <TextBlock Grid.Row="2" Text="Entry Date" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtEntryDate" Grid.Row="2" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Background="#F8FAFC" Margin="0,16,309,10"
                                         Text="{Binding CurrentSubject.EntryDate, StringFormat={}{0:dd-MMM-yyyy}}" Grid.RowSpan="2"/>

                                <TextBlock Grid.Row="8" Text="Last Update" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBox x:Name="txtLastUpdate" Grid.Row="8" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Background="#F8FAFC"
                                         Text="{Binding CurrentSubject.LastUpdate, StringFormat={}{0:dd-MMM-yyyy HH:mm}}" Margin="0,16,309,0" Grid.RowSpan="2"/>
                            </Grid>
                        </Border>
                    </Expander>

                    <DataGrid x:Name="dgSubjectList" Grid.Row="2" 
                              ItemsSource="{Binding SubjectList}" 
                              SelectedItem="{Binding SelectedSubject, UpdateSourceTrigger=PropertyChanged}"
                              AutoGenerateColumns="False" IsReadOnly="True" Background="White" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" HeadersVisibility="Column" 
                              Margin="0,0,0,15">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Subject Code" Binding="{Binding SubjectCode}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Subject Desc" Binding="{Binding SubjectDesc}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid x:Name="InputForm" Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subject Code" Foreground="#6B7280" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtSubjectCode" Grid.Row="1" Grid.Column="0" 
                                 Text="{Binding CurrentSubject.SubjectCode, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="True"
                                 MaxLength="2" Height="40" FontWeight="Bold" HorizontalContentAlignment="Center" Margin="0,0,60,0"/>

                        <TextBlock Grid.Row="0" Text="Subject Description" Foreground="#6B7280" FontSize="11" Margin="81,0,0,5" Grid.ColumnSpan="2"/>
                        <TextBox x:Name="txtSubjectDesc" Grid.Row="1" 
                                 Text="{Binding CurrentSubject.SubjectDesc, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="{Binding IsNotEditable}"
                                 Height="40" HorizontalContentAlignment="Center" Margin="81,0,60,0" Grid.ColumnSpan="2"/>
                    </Grid>

                    <UniformGrid x:Name="ugActionButtons" Grid.Row="4" Columns="5" Height="45">
                        <Button Content="ADD" Style="{StaticResource AddButtonStyle}" Margin="2,0" Command="{Binding AddCommand}"/>
                        <Button Content="SAVE" Style="{StaticResource SaveButtonStyle}" Margin="2,0" Command="{Binding SaveCommand}"/>
                        <Button Content="DELETE" Style="{StaticResource DeleteButtonStyle}" Margin="2,0" Command="{Binding DeleteCommand}"/>
                        <Button Content="EDIT" Style="{StaticResource EditButtonStyle}" Margin="2,0" Command="{Binding EditCommand}"/>
                        <Button Content="EXIT" Style="{StaticResource ExitButtonStyle}" Margin="2,0" Command="{Binding ExitCommand}"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>