<Window x:Class="View_WPF.frm_ClassWiseExamBatch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="Class Wish Exam Batch Setup" Height="500" Width="950"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        AllowsTransparency="True" WindowStyle="None">

    <Window.Resources>
        <!-- Futuristic Button Style -->
        <Style x:Key="FuturisticButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="3" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.BorderBrush>
                                <LinearGradientBrush x:Name="BtnGradient" StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF007ACC" Offset="0.0"/>
                                    <GradientStop Color="#FF00FFCC" Offset="0.3"/>
                                    <GradientStop Color="#FFE61A5F" Offset="0.6"/>
                                    <GradientStop Color="#FFFFD700" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F8F9FA"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainContainer" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="MainContainerTransform" Storyboard.TargetProperty="Y" From="50" To="0" Duration="0:0:0.8"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <PointAnimation Storyboard.TargetName="MainRainbowGradient" Storyboard.TargetProperty="StartPoint" From="0,0" To="1,1" Duration="0:0:5" AutoReverse="True"/>
                    <PointAnimation Storyboard.TargetName="MainRainbowGradient" Storyboard.TargetProperty="EndPoint" From="1,1" To="0,0" Duration="0:0:5" AutoReverse="True"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="MainContainer" Margin="15" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MainContainerTransform" Y="50"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Class Wish Exam Batch Setup" FontSize="20" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" CornerRadius="15" BorderThickness="3" Background="White">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="MainRainbowGradient" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF007ACC" Offset="0.0"/>
                    <GradientStop Color="#FF00FFCC" Offset="0.25"/>
                    <GradientStop Color="#FFE61A5F" Offset="0.5"/>
                    <GradientStop Color="#FFFFD700" Offset="0.75"/>
                    <GradientStop Color="#FF9400D3" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#CCCCCC" Direction="270" ShadowDepth="3" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F8F9FA" CornerRadius="10" Margin="0,0,15,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Batch ID" FontSize="14" Foreground="#555555" VerticalAlignment="Center" FontWeight="Medium"/>
                            <TextBox Grid.Column="1" Text="{Binding BatchID, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Batch Date" FontSize="14" Foreground="#555555" VerticalAlignment="Center" FontWeight="Medium"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding BatchDate, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <ListView ItemsSource="{Binding BatchList}" SelectedItem="{Binding SelectedBatch}" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Batch ID" DisplayMemberBinding="{Binding BatchID}" Width="150"/>
                                    <GridViewColumn Header="Batch Date" DisplayMemberBinding="{Binding BatchDate, StringFormat='{}{0:dd-MMM-yyyy}'}" Width="250"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="ADD" Style="{StaticResource FuturisticButtonStyle}" Command="{Binding AddCommand}" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="SAVE" Style="{StaticResource FuturisticButtonStyle}" Command="{Binding SaveCommand}" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Content="EDIT" Style="{StaticResource FuturisticButtonStyle}" Command="{Binding EditCommand}" Margin="0,0,12,0"/>
            <Button Grid.Column="3" Content="EXIT" Style="{StaticResource FuturisticButtonStyle}" Command="{Binding ExitCommand}" Margin="0,0,12,0"/>
        </Grid>
    </Grid>
</Window>