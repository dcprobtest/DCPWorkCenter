<Window x:Class="View_WPF.frmAssignTechInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="Assign Tech Info Management" Height="680" Width="780"
        WindowStartupLocation="CenterScreen" Background="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#15007AFF" Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-250,-250,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="30,30,30,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Assign Tech Information Management" FontSize="30" FontWeight="Bold" Foreground="#FF0A0909" Margin="0,0,0,25" HorizontalAlignment="Center"/>

                <Border Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                    <Border.Background>
                        <LinearGradientBrush x:Name="MainBorderBrush" StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                            <GradientStop Color="#00FF00" Offset="0.4"/>
                            <GradientStop Color="#00FFFF" Offset="0.6"/>
                            <GradientStop Color="#0000FF" Offset="0.8"/>
                            <GradientStop Color="#FF00FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="MainBorderRotate" 
                                                     Storyboard.TargetProperty="Angle" 
                                                     From="0" To="360" 
                                                     Duration="0:0:12" 
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Border Background="#FFEBEAE9" CornerRadius="23" Padding="25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Assign Tech Info ID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding AssignTechInfoID, StringFormat={}{0:#}, Mode=OneWay}" IsReadOnly="True" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Assign ID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding AssignID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Scrum ID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding ScrumID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ScrumList}" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Entry By UID" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EntryByUID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsReadOnly="True" MaxLength="6" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Entry Date" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding EntryDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="5" Grid.Column="0" HorizontalAlignment="Stretch"/>

                            <CheckBox IsChecked="{Binding IsActivated, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,20" VerticalAlignment="Center">
                                <TextBlock Text="Activate Information" Foreground="Black" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </CheckBox>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Tech Information List" Foreground="#555555" FontWeight="SemiBold" Margin="0,0,0,5"/>

                            <Border Grid.Row="1" Grid.RowSpan="6" Grid.Column="4" Margin="0,0,0,20" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="White" Height="190" VerticalAlignment="Stretch">
                                <ListBox ItemsSource="{Binding TechInfoList}" SelectedItem="{Binding SelectedTechInfo, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="5" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Scrum ID: " FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ScrumID}" FontSize="14" FontWeight="Bold" Foreground="#111111" Margin="2,0,15,0"/>
                                                    <TextBlock Grid.Column="2" Text="By: " FontSize="13" FontWeight="Normal" Foreground="#777777"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding EntryByUID}" FontSize="13" FontWeight="SemiBold" Foreground="#555555" Margin="2,0,5,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Command="{Binding AddCommand}" Content="ADD" Style="{StaticResource RainbowButtonStyle}" Grid.Column="0" Height="45"/>
                                <Button Command="{Binding SaveCommand}" Content="SAVE" Style="{StaticResource RainbowButtonStyle}" Grid.Column="2" Height="45"/>
                                <Button Command="{Binding EditCommand}" Content="EDIT" Style="{StaticResource RainbowButtonStyle}" Grid.Column="4" Height="45"/>
                                <Button Command="{Binding ExitCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="EXIT" Style="{StaticResource RainbowButtonStyle}" Grid.Column="6" Height="45"/>
                            </Grid>

                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>