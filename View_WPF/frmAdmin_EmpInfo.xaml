<Window x:Class="View_WPF.frmAdmin_EmpInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Information" Height="750" Width="850" 
        Background="White" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,3,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="Button" x:Key="RainbowButtonStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="8" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5" x:Name="BtnRotate"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0B0D" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:3" From="0" To="360" RepeatBehavior="Forever" Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Blur Effect -->
        <Ellipse Fill="#15007AFF" Height="600" Width="600" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-200,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock FontSize="28" FontWeight="Bold" Foreground="#FF0A0909" HorizontalAlignment="Center" Margin="0,0,0,15" Text="Employee Information"/>

                <!-- Main Form Area -->
                <Border CornerRadius="20" Grid.Row="1" HorizontalAlignment="Center" Padding="2" VerticalAlignment="Top" Width="780">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5" x:Name="MainBorderRotate"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                            <GradientStop Color="#00FF00" Offset="0.4"/>
                            <GradientStop Color="#00FFFF" Offset="0.6"/>
                            <GradientStop Color="#0000FF" Offset="0.8"/>
                            <GradientStop Color="#FF00FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Duration="0:0:8" From="0" To="360" RepeatBehavior="Forever" Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Border Background="#FFF4F4F3" CornerRadius="18" Padding="25,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: User ID, First Name, Last Name, DOB -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="User ID (UID)"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Emp.UID, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="First Name"/>
                                <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding Emp.FName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="4" Grid.Row="0" Text="Last Name"/>
                                <TextBox Grid.Column="4" Grid.Row="1" Text="{Binding Emp.LName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="6" Grid.Row="0" Text="Date of Birth"/>
                                <DatePicker Grid.Column="6" Grid.Row="1" SelectedDate="{Binding Emp.DOB, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 1: Address Line 1 & 2 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Address Line 1"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Emp.Address1, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="Address Line 2"/>
                                <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding Emp.Address2, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 2: City, State, Zip, Country -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="City"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Emp.City, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="State"/>
                                <ComboBox Grid.Column="2" Grid.Row="1" DisplayMemberPath="DisplayName" ItemsSource="{Binding States}" SelectedValue="{Binding SelectedStateString, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="StateCode"/>

                                <TextBlock Grid.Column="4" Grid.Row="0" Text="Zip Code"/>
                                <TextBox Grid.Column="4" Grid.Row="1" Text="{Binding Emp.Zip, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="6" Grid.Row="0" Text="Country"/>
                                <TextBox Grid.Column="6" Grid.Row="1" Text="{Binding Emp.Country, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 3: Phone, Email -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Phone"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Emp.Phone, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="Email"/>
                                <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding Emp.Email, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 4: Primary ID, Secondary ID, Dept Code, Desig Code -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Primary ID"/>
                                <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding Emp.PrimaryID, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="Secondary ID"/>
                                <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding Emp.SecondID, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="4" Grid.Row="0" Text="Dept Code"/>
                                <TextBox Grid.Column="4" Grid.Row="1" Text="{Binding Emp.DeptCode, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="6" Grid.Row="0" Text="Desig Code"/>
                                <TextBox Grid.Column="6" Grid.Row="1" Text="{Binding Emp.DesigCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 5: Entry Date, Start Date, End Date -->
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Entry Date"/>
                                <DatePicker Grid.Column="0" Grid.Row="1" SelectedDate="{Binding Emp.EntryDate, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="Start Date"/>
                                <DatePicker Grid.Column="2" Grid.Row="1" SelectedDate="{Binding Emp.StartDate, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="4" Grid.Row="0" Text="End Date"/>
                                <DatePicker Grid.Column="4" Grid.Row="1" SelectedDate="{Binding Emp.EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Row 6: Checkbox -->
                            <CheckBox Grid.Row="6" IsChecked="{Binding IsActive}" Margin="0,5,0,15" VerticalAlignment="Center">
                                <TextBlock FontSize="14" Foreground="Black" Margin="0" Text="Activate Employee Profile"/>
                            </CheckBox>

                            <!-- Row 7: Submit Button -->
                            <Button Grid.Row="7" Command="{Binding SaveCommand}" Content="SAVE EMPLOYEE INFO" Height="40" Width="220" HorizontalAlignment="Center" Style="{StaticResource RainbowButtonStyle}"/>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>