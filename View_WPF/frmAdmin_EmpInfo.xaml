<Window x:Class="View_WPF.frmAdmin_EmpInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Information" Height="650" Width="850" 
        Background="White" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style TargetType="Button" x:Key="RainbowButtonStyle">
            <Setter Property="Foreground" Value="#0055FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="8" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5" x:Name="BtnRotate"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Inner Background White & Text Bold Blue -->
                                <Border Background="White" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0:0:3" From="0" To="360" RepeatBehavior="Forever" Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Blur Effect -->
        <Ellipse Fill="#15007AFF" Height="600" Width="600" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-200,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock FontSize="28" FontWeight="Bold" Foreground="#FF0A0909" HorizontalAlignment="Center" Margin="0,0,0,15" Text="Employee Information"/>

                <!-- Main Rainbow Border -->
                <Border CornerRadius="20" Grid.Row="1" HorizontalAlignment="Center" Padding="2" VerticalAlignment="Top" Width="780">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform Angle="0" CenterX="0.5" CenterY="0.5" x:Name="MainBorderRotate"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                            <GradientStop Color="#00FF00" Offset="0.4"/>
                            <GradientStop Color="#00FFFF" Offset="0.6"/>
                            <GradientStop Color="#0000FF" Offset="0.8"/>
                            <GradientStop Color="#FF00FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Duration="0:0:8" From="0" To="360" RepeatBehavior="Forever" Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Border Background="#FFF4F4F3" CornerRadius="18" Padding="25,20">
                        <!-- SINGLE GRID WITH NO INNER NESTED GRIDS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Row 0: Labels (UID, FName, LName, DOB) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 1: Inputs (UID, FName, LName, DOB) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 2: Labels (Addr 1, Addr 2) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 3: Inputs (Addr 1, Addr 2) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 4: Labels (City, State, Zip, Country) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 5: Inputs (City, State, Zip, Country) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 6: Labels (Phone, Email, Dept, Desig) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 7: Inputs (Phone, Email, Dept, Desig) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 8: Labels (Pri ID, Sec ID, Start, End) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 9: Inputs (Pri ID, Sec ID, Start, End) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 10: Labels (Entry Date) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 11: Inputs (Entry Date, Active Checkbox) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 12: Submit Button -->
                            </Grid.RowDefinitions>

                            <!-- ================= ROW 0 & 1: UID, FName, LName, DOB ================= -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID (UID)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Emp.UID, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="First Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Emp.FName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Last Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Emp.LName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Date of Birth" Style="{StaticResource FieldLabel}"/>
                            <DatePicker Grid.Row="1" Grid.Column="6" SelectedDate="{Binding Emp.DOB, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- ================= ROW 2 & 3: Address Line 1, Address Line 2 ================= -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Address Line 1" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Emp.Address1, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" Text="Address Line 2" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="3" Text="{Binding Emp.Address2, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- ================= ROW 4 & 5: City, State, Zip, Country ================= -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="City" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding Emp.City, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="2" Text="State" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding States}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding SelectedStateString, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="4" Text="Zip Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding Emp.Zip, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4" Grid.Column="6" Text="Country" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="6" Text="{Binding Emp.Country, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- ================= ROW 6 & 7: Phone, Email, Dept, Desig ================= -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Phone" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="0" Text="{Binding Emp.Phone, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="2" Text="Email" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding Emp.Email, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="4" Text="Department" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="7" Grid.Column="4" ItemsSource="{Binding Departments}" DisplayMemberPath="DisplayName" SelectedValuePath="DeptCode" SelectedValue="{Binding SelectedDeptCode, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="6" Grid.Column="6" Text="Designation" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="7" Grid.Column="6" ItemsSource="{Binding Designations}" DisplayMemberPath="DisplayName" SelectedValuePath="DesigCode" SelectedValue="{Binding SelectedDesigCode, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- ================= ROW 8 & 9: Primary ID, Second ID, Start Date, End Date ================= -->

                            <TextBlock Grid.Row="7" Text="Start Date" Style="{StaticResource FieldLabel}" Margin="0,39,0,37" Grid.RowSpan="3"/>
                            <DatePicker Grid.Row="9" SelectedDate="{Binding Emp.StartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6"/>

                            <TextBlock Grid.Row="7" Grid.Column="1" Text="End Date" Style="{StaticResource FieldLabel}" Grid.ColumnSpan="3" Margin="15,37,14,39" Grid.RowSpan="3"/>
                            <DatePicker Grid.Row="9" Grid.Column="1" SelectedDate="{Binding Emp.EndDate, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="3" Margin="15,6,14,6"/>

                            <!-- ================= ROW 10 & 11: Entry Date & Active Checkbox ================= -->

                            <CheckBox Grid.Row="9" Grid.Column="4" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="4,0,5,0">
                                <TextBlock FontSize="13" Foreground="Black" Text="Activate Employee Profile"/>
                            </CheckBox>

                            <!-- ================= ROW 12: SAVE BUTTON ================= -->
                            <Button Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="7" Command="{Binding SaveCommand}" Content="SAVE EMPLOYEE INFO" Height="40" Width="220" HorizontalAlignment="Center" Margin="0,15,0,0" Style="{StaticResource RainbowButtonStyle}"/>

                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>