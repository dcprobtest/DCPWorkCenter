<Window x:Class="View_WPF.frmAdmin_EmpInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Information" Height="900" Width="1000"
        WindowStartupLocation="CenterScreen" Background="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,10,15"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0B0D" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#15007AFF" Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-250,-250,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Employee Information" FontSize="32" FontWeight="Bold" Foreground="#FF0A0909" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <Border Grid.Row="1" Width="850" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                            <GradientStop Color="#00FF00" Offset="0.4"/>
                            <GradientStop Color="#00FFFF" Offset="0.6"/>
                            <GradientStop Color="#0000FF" Offset="0.8"/>
                            <GradientStop Color="#FF00FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Border Background="#FFEBEAE9" CornerRadius="23" Padding="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="User ID (UID)" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="First Name" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Last Name" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="Date of Birth (DOB)" Foreground="#666" Margin="10,0,0,5"/>
                            <DatePicker Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="10,0,10,15"/>

                            <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Text="Address Line 1" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="5" Grid.ColumnSpan="4"/>

                            <TextBlock Grid.Row="6" Grid.ColumnSpan="4" Text="Address Line 2" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="7" Grid.ColumnSpan="4"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Text="City" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2" Text="State" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="9" Grid.Column="2" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Text="Zip Code" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="2" Text="Country" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Text="Primary ID" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="12" Grid.Column="2" Grid.ColumnSpan="2" Text="Secondary ID" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="13" Grid.Column="2" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Text="Department Code" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="14" Grid.Column="2" Grid.ColumnSpan="2" Text="Designation Code" Foreground="#666" Margin="10,0,0,5"/>
                            <TextBox Grid.Row="15" Grid.Column="2" Grid.ColumnSpan="2"/>

                            <TextBlock Grid.Row="16" Grid.Column="0" Text="Entry Date" Foreground="#666" Margin="10,0,0,5"/>
                            <DatePicker Grid.Row="17" Grid.Column="0" Margin="10,0,5,15"/>

                            <TextBlock Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" Text="Start Date" Foreground="#666" Margin="10,0,0,5" HorizontalAlignment="Center"/>
                            <DatePicker Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,0,5,15"/>

                            <TextBlock Grid.Row="16" Grid.Column="3" Text="End Date" Foreground="#666" Margin="10,0,0,5"/>
                            <DatePicker Grid.Row="17" Grid.Column="3" Margin="5,0,10,15"/>

                            <CheckBox Grid.Row="18" Grid.ColumnSpan="4" Margin="15,15,0,15" VerticalAlignment="Center">
                                <TextBlock Text="Activate Employee Profile" Foreground="Black" FontSize="16" Margin="10,0,0,0"/>
                            </CheckBox>

                            <Button Grid.Row="19" Grid.ColumnSpan="4" Height="50" Width="300" 
                                    Content="SAVE EMPLOYEE INFO" 
                                    Style="{StaticResource RainbowButtonStyle}" 
                                    Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>