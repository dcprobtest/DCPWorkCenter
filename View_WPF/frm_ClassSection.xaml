<Window x:Class="View_WPF.frm_ClassSection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModelView_WPF;assembly=ModelView_WPF"
        Title="Class Section Management" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" 
        Background="#F4F7F9"
        ResizeMode="CanResize">

    <Window.DataContext>
        <local:ClassSectionViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="6" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#6366F1" CornerRadius="5" Opacity="0.9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="20" CornerRadius="15" Padding="2.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF0000" Offset="0.0"/>
                    <GradientStop Color="#00FF00" Offset="0.5"/>
                    <GradientStop Color="#0000FF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Border Background="White" CornerRadius="13" Padding="25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,25,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" 
                                  ItemsSource="{Binding ClassSectionList}" 
                                  SelectedItem="{Binding SelectedClassSection}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  Background="White"
                                  BorderBrush="#E0E0E0"
                                  RowHeight="35"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F1F1"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Section ID" Binding="{Binding SectionId}" Width="100" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Section Description" Binding="{Binding SectionDesc}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="1" Margin="0,20,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Section ID" Margin="0,0,0,5" Foreground="#666" FontSize="11"/>
                            <TextBox Grid.Row="1" Grid.Column="0" 
                                     Text="{Binding ClassSection.SectionId, UpdateSourceTrigger=PropertyChanged}" 
                                     HorizontalContentAlignment="Center" Height="40"/>

                            <TextBlock Grid.Column="1" Text="Section Description" Margin="10,0,0,5" Foreground="#666" FontSize="11"/>
                            <TextBox Grid.Row="1" Grid.Column="1" 
                                     Text="{Binding ClassSection.SectionDesc, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="10,0,0,0" Height="40"/>
                        </Grid>

                        <UniformGrid Grid.Row="2" Columns="5">
                            <Button Content="ADD" Style="{StaticResource RainbowButtonStyle}" Margin="2" Command="{Binding AddCommand}"/>
                            <Button Content="SAVE" Style="{StaticResource RainbowButtonStyle}" Margin="2" Command="{Binding SaveCommand}"/>
                            <Button Content="DELETE" Style="{StaticResource RainbowButtonStyle}" Margin="2" Command="{Binding DeleteCommand}"/>
                            <Button Content="EDIT" Style="{StaticResource RainbowButtonStyle}" Margin="2" Command="{Binding EditCommand}"/>
                            <Button Content="EXIT" Style="{StaticResource RainbowButtonStyle}" Margin="2" Command="{Binding ExitCommand}"/>
                        </UniformGrid>
                    </Grid>

                    <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="User ID (Entry By)" Foreground="#666" FontSize="11" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding ClassSection.EntryByUid, UpdateSourceTrigger=PropertyChanged}" Margin="0,18,0,0" Height="35"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding ClassSection.Activate}" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="Is Active" Foreground="#333" FontWeight="SemiBold"/>
                                </CheckBox>
                                <Button Grid.Column="1" Content="Active Now" 
                                        Style="{StaticResource RainbowButtonStyle}" 
                                        Command="{Binding ActiveClickCommand}" Height="35"/>
                            </Grid>

                            <Expander Grid.Row="2" Header="View Timeline (Dates)" Foreground="#8B5CF6" FontWeight="SemiBold" IsExpanded="True" VerticalAlignment="Top">
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,10,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Entry Date" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="1" Text="{Binding ClassSection.EntryDate, StringFormat='dd-MMM-yyyy'}" Margin="0,2,0,10" IsReadOnly="True" Background="#F5F5F5"/>

                                        <TextBlock Grid.Row="2" Text="Start Date" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="3" Text="{Binding ClassSection.StartDate, StringFormat='dd-MMM-yyyy'}" Margin="0,2,0,10" IsReadOnly="True" Background="#F5F5F5"/>

                                        <TextBlock Grid.Row="4" Text="End Date" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="5" Text="{Binding ClassSection.EndDate, StringFormat='dd-MMM-yyyy'}" Margin="0,2,0,10" IsReadOnly="True" Background="#F5F5F5"/>

                                        <TextBlock Grid.Row="6" Text="Last Update" FontSize="10" Foreground="Gray"/>
                                        <TextBox Grid.Row="7" Text="{Binding ClassSection.LastUpdate, StringFormat='dd-MMM-yyyy'}" Margin="0,2,0,0" IsReadOnly="True" Background="#F5F5F5"/>
                                    </Grid>
                                </Border>
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>