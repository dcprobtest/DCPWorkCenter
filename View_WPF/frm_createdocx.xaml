<Window x:Class="View_WPF.frm_createdocx"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Creation" Height="850" Width="950"
        WindowStartupLocation="CenterScreen" Background="#FFF7F7F7"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                                        <GradientStop Color="#00FF00" Offset="0.4"/>
                                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                                        <GradientStop Color="#0000FF" Offset="0.8"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0B0D" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse IsHitTestVisible="False" Fill="#156200EE" Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-150">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Document Creation Form" FontSize="30" Foreground="Black" Margin="0,0,0,20" HorizontalAlignment="Center" FontWeight="Bold"/>

            <Border Grid.Row="1" Width="850" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="20" Padding="2">
                <Border.Background>
                    <LinearGradientBrush x:Name="MainGradient" StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Border Background="#FFEBEAE9" CornerRadius="18" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="User ID" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtUserID" Grid.Row="1" Grid.Column="0" Margin="10,0,10,10" IsReadOnly="True" Background="#F0F0F0"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="User Name" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtUserName" Grid.Row="1" Grid.Column="1" Margin="10,0,10,10" IsReadOnly="True" Background="#F0F0F0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Document Type" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbDocType" Grid.Row="3" Grid.Column="0" Margin="10,0,10,10" SelectionChanged="cmbDocType_SelectionChanged">
                            <ComboBoxItem Content="CPT"/>
                            <ComboBoxItem Content="OPT"/>
                            <ComboBoxItem Content="STEM OPT"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Candidate ID" Margin="10,0,0,2" FontWeight="SemiBold"/>

                        <ComboBox x:Name="cmbCandidateID" 
                                  Grid.Row="3" Grid.Column="1" 
                                  Margin="10,0,10,10" 
                                  IsEditable="True" 
                                  SelectedValuePath="UID" 
                                  KeyUp="cmbCandidateID_KeyUp" 
                                  SelectionChanged="cmbCandidateID_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UID}" FontWeight="Bold" Width="60"/>
                                        <TextBlock Text=" - " Foreground="Gray"/>
                                        <TextBlock Text="{Binding FName}"/>
                                        <TextBlock Text=" "/>
                                        <TextBlock Text="{Binding LName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Job Designation" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtDesignation" Grid.Row="5" Grid.ColumnSpan="2" Margin="10,0,10,10"/>

                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Job Responsibility" Margin="10,5,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtResponsibility" Grid.Row="7" Grid.ColumnSpan="2" Margin="10,0,10,10" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Job Start Date" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dtpStartDate" SelectedDateChanged="dtpStartDate_SelectedDateChanged" Grid.Row="8" Grid.Column="0" Margin="12,17,8,11" Grid.RowSpan="2"/>

                        <TextBlock Grid.Row="8" Grid.Column="1" Text="Job End Date" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dtpEndDate" Grid.Row="9" Grid.Column="1" Margin="10,0,10,10"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Hourly Rate ($)" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtHourlyRate" Grid.Row="11" Grid.Column="0" Margin="10,0,10,10"/>

                        <TextBlock Grid.Row="10" Grid.Column="1" Text="Weekly Hours (H)" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtWeeklyHours" Grid.Row="11" Grid.Column="1" Margin="10,0,10,10"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Email" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtEmail" Grid.Row="13" Grid.Column="0" Margin="10,0,10,10"/>

                        <TextBlock Grid.Row="12" Grid.Column="1" Text="CC Email" Margin="10,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtCCEmail" Grid.Row="13" Grid.Column="1" Margin="10,0,10,10" IsEnabled="False" Background="#F0F0F0"/>

                        <Button x:Name="btnCreateDocument" Grid.Row="14" Grid.ColumnSpan="2" Content="CREATE DOCUMENT" 
                                Style="{StaticResource RainbowButtonStyle}" 
                                Width="280" Height="50" Margin="0,20,0,5"
                                Click="btnCreateDocument_Click"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>