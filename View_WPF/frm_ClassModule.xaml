<Window x:Class="View_WPF.frm_ClassModule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModelView_WPF;assembly=ModelView_WPF"
        Title="Class Module Management" 
        Height="700" Width="800"
        WindowStartupLocation="CenterScreen" 
        Background="White"
        ResizeMode="NoResize">

    <Window.DataContext>
         <vm:ClassModuleViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#00FF00" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0B0D" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#15FF9100" Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-150">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Class Module" FontSize="32" FontWeight="Bold" Foreground="#FF1A1A1C" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Width="650" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Border Background="#FFEBEAE9" CornerRadius="23" Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Course Code" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,10,15"
                                 Text="{Binding CurrentModule.CourseCode, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Course Description" Foreground="#666" Margin="10,0,10,5"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Height="80" 
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="10,0,10,15"
                                 Text="{Binding CurrentModule.CourseDesc, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Entry Date" Foreground="#666" FontSize="12" Margin="10,5,10,2"/>
                        <DatePicker Grid.Row="5" Grid.Column="0" Margin="10,0,10,15"
                                    SelectedDate="{Binding CurrentModule.EntryDate, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Start Date" Foreground="#666" FontSize="12" Margin="10,5,10,2"/>
                        <DatePicker Grid.Row="5" Grid.Column="1" Margin="10,0,10,15"
                                    SelectedDate="{Binding CurrentModule.StartDate, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="4" Grid.Column="2" Text="End Date" Foreground="#666" FontSize="12" Margin="10,5,10,2"/>
                        <DatePicker Grid.Row="5" Grid.Column="2" Margin="10,0,10,15"
                                    SelectedDate="{Binding CurrentModule.EndDate, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Grid.Row="6" Grid.ColumnSpan="3" Margin="10,10,0,20" VerticalAlignment="Center"
                                  IsChecked="{Binding IsActiveChecked}">
                            <TextBlock Text="Activate Class Module" Foreground="Black" FontSize="16" Margin="10,0,0,0"/>
                        </CheckBox>

                        <Button Grid.Row="7" Grid.ColumnSpan="3" Height="50" Width="280" 
                                Content="SAVE CLASS INFO" 
                                Style="{StaticResource RainbowButtonStyle}" 
                                HorizontalAlignment="Center"
                                Command="{Binding SaveCommand}"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>