<Window x:Class="View_WPF.frmAdmin_Designation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModelView_WPF;assembly=ModelView_WPF"
        Title="Designation Management" Height="580" Width="720"
        WindowStartupLocation="CenterScreen" Background="#FFF7F7F7"
        ResizeMode="NoResize">

    <Window.DataContext>
        <vm:DesignationViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="Black"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="8" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#00FF00" Offset="0.0"/>
                                        <GradientStop Color="#00FFFF" Offset="0.3"/>
                                        <GradientStop Color="#0000FF" Offset="0.6"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0B0D" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Blur Effect -->
        <Ellipse IsHitTestVisible="False" Fill="#1500FF95" Width="500" Height="450" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-60">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="Designation Setup" FontSize="22" Foreground="#222" Margin="0,0,0,15" HorizontalAlignment="Center" FontWeight="Bold"/>

            <!-- Main Rainbow Border -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="14" Padding="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <!-- Inner Card Form Area -->
                <Border Background="#FFEBEAE9" CornerRadius="12" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Row 0: Code & Name -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: 3 Dates -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Responsibility -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 3: Description -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 4: Active Checkbox -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 5: Save Button -->
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Designation Code & Designation Name -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Designation Code" Foreground="#1C1B1B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDesigCode" Grid.Row="1" Height="30" Text="{Binding Designation.DesigCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" MaxLength="10"/>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Designation Name" Foreground="#1C1B1B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDesigName" Grid.Row="1" Height="30" Text="{Binding Designation.DesigName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Row 1: 3 Date Pickers (Entry Date, Start Date, End Date) -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Entry Date" Foreground="#1C1B1B" FontSize="12" Margin="0,0,0,4"/>
                                <DatePicker Grid.Row="1" Height="30" VerticalContentAlignment="Center" SelectedDate="{Binding Designation.EntryDate, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Grid.Column="1" Margin="4,0,4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Start Date" Foreground="#1C1B1B" FontSize="12" Margin="0,0,0,4"/>
                                <DatePicker Grid.Row="1" Height="30" VerticalContentAlignment="Center" SelectedDate="{Binding Designation.StartDate, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Grid.Column="2" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="End Date" Foreground="#1C1B1B" FontSize="12" Margin="0,0,0,4"/>
                                <DatePicker Grid.Row="1" Height="30" VerticalContentAlignment="Center" SelectedDate="{Binding Designation.EndDate, Mode=TwoWay}"/>
                            </Grid>
                        </Grid>

                        <!-- Row 2: Responsibility -->
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Responsibility" Foreground="#1C1B1B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtResponsibility" Grid.Row="1" Height="30" Text="{Binding Designation.Responsiblity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Row 3: Description -->
                        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Description" Foreground="#1C1B1B" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDescription" Grid.Row="1" Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" 
                                     Text="{Binding Designation.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Row 4: Active Status Checkbox -->
                        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,20" VerticalAlignment="Center" IsChecked="{Binding IsActiveChecked, Mode=TwoWay}">
                            <TextBlock Text="Mark as Active" Foreground="Black" FontSize="13" Margin="4,0,0,0"/>
                        </CheckBox>

                        <!-- Row 5: Save Button -->
                        <Button x:Name="btnSaveDesignation" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                                Height="38" Width="180" 
                                Content="SAVE DESIGNATION" 
                                Style="{StaticResource RainbowButtonStyle}" 
                                HorizontalAlignment="Center" 
                                Command="{Binding SaveCommand}"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>