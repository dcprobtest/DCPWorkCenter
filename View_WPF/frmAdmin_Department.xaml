<Window x:Class="View_WPF.frmAdmin_Department"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department Management" Height="680" Width="1040"
        WindowStartupLocation="CenterScreen" Background="#FFF7F7F7"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CaretBrush" Value="Black"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="8" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                                        <GradientStop Color="#00FF00" Offset="0.4"/>
                                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                                        <GradientStop Color="#0000FF" Offset="0.8"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Blur Effect -->
        <Ellipse IsHitTestVisible="False" Fill="#156200EE" Width="500" Height="450" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-60">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="40,40,60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="Department Management" FontSize="32" FontWeight="Bold" Foreground="#FF1A1A1C" Margin="0,0,0,30" HorizontalAlignment="Center"/>

            <!-- Main Rainbow Border -->
            <Border Grid.Row="1" Width="920" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="25" Padding="2">
                <Border.Background>
                    <LinearGradientBrush x:Name="MainGradient" StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:10" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <!-- Inner Card Form Area -->
                <Border Background="#FFEBEAE9" CornerRadius="23" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Department Code & Department Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Department Code" Foreground="#666" Margin="10,0,10,3"/>
                        <TextBox x:Name="txtDeptCode" Text="{Binding Dept.DeptCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Grid.Row="1" Grid.Column="0" Width="105" HorizontalAlignment="Left" Margin="10,3,0,16" MaxLength="10"/>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Department Name" Foreground="#666" Margin="146,0,0,3" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <TextBox x:Name="txtDeptName" Text="{Binding Dept.DeptName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Grid.Row="1" Width="188" HorizontalAlignment="Left" Margin="144,3,0,16" Grid.ColumnSpan="2"/>

                        <!-- Row 1: Entry Date, Start Date, End Date -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Entry Date" Foreground="#666" Margin="10,0,10,3"/>
                        <DatePicker SelectedDate="{Binding Dept.EntryDate, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Grid.Row="3" Grid.Column="0" Width="105" HorizontalAlignment="Left" Margin="10,3,0,15"/>

                        <TextBlock Grid.Row="1" Text="Start Date" Foreground="#666" Margin="141,71,0,3" HorizontalAlignment="Left" Grid.RowSpan="2" Width="66" Grid.ColumnSpan="2"/>
                        <DatePicker SelectedDate="{Binding Dept.StartDate, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Grid.Row="3" Width="112" HorizontalAlignment="Left" Margin="138,3,0,15" Grid.ColumnSpan="2"/>

                        <TextBlock Grid.Row="1" Grid.Column="1" Text="End Date" Foreground="#666" Margin="76,71,0,3" HorizontalAlignment="Left" Grid.RowSpan="2" Width="130" Grid.ColumnSpan="2"/>
                        <DatePicker SelectedDate="{Binding Dept.EndDate, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Grid.Row="3" Grid.Column="1" Width="117" HorizontalAlignment="Left" Margin="75,3,0,15" Grid.ColumnSpan="2"/>

                        <!-- Row 2: Responsibility -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="Responsibility" Foreground="#666" Margin="10,0,10,3"/>
                        <TextBox x:Name="txtResponsibility" Text="{Binding Dept.Responsiblity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Width="386" HorizontalAlignment="Left" Margin="10,0,0,12"/>

                        <!-- Row 3: Description -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="Description" Foreground="#666" FontSize="12" Margin="10,0,10,3"/>
                        <TextBox x:Name="txtDescription" Text="{Binding Dept.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Width="386" Height="50" HorizontalAlignment="Left" Margin="10,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                        <!-- Row 3 right side: Active Status Checkbox -->
                        <CheckBox Grid.Row="8" Grid.Column="2" Margin="54,0,0,12" IsChecked="{Binding IsActive, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" HorizontalAlignment="Left" Width="140" Height="16" VerticalAlignment="Bottom" Grid.ColumnSpan="2">
                            <TextBlock Text="Active Status" Foreground="Black" FontSize="13"/>
                        </CheckBox>

                        <!-- ListView with fixed Height and ScrollViewer -->
                        <ScrollViewer Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" Grid.ColumnSpan="2" 
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" 
                                      Height="205" Margin="75,0,85,0">
                            <ListView ItemsSource="{Binding DeptList}" 
                                      SelectedItem="{Binding SelectedDept}" 
                                      BorderBrush="Transparent" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Dept Code" DisplayMemberBinding="{Binding DeptCode}" Width="85"/>
                                        <GridViewColumn Header="Dept Name" DisplayMemberBinding="{Binding DeptName}" Width="110"/>
                                        <GridViewColumn Header="Entry Date" DisplayMemberBinding="{Binding EntryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="80"/>
                                        <GridViewColumn Header="Active" DisplayMemberBinding="{Binding IsActive}" Width="50"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ScrollViewer>

                        <!-- Action Buttons -->
                        <Button Command="{Binding AddCommand}" Grid.Row="8" Grid.Column="0" Height="32" Width="65" 
                                Content="ADD" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="10,5,0,0"/>

                        <Button x:Name="btnSaveDepartment" Command="{Binding SaveCommand}" Grid.Row="8" Grid.Column="0" Height="32" Width="65" 
                                Content="SAVE" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="82,5,0,0"/>

                        <Button Command="{Binding EditCommand}" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Height="32" Width="65" 
                                Content="EDIT" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="154,5,0,0"/>

                        <Button Command="{Binding DeleteCommand}" Grid.Row="8" Grid.Column="1" Height="32" Width="72" 
                                Content="DELETE" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="26,5,0,0"/>

                        <Button Command="{Binding ExitCommand}" Grid.Row="8" Grid.Column="1" Height="32" Width="72" 
                                Content="EXIT" Style="{StaticResource RainbowButtonStyle}" HorizontalAlignment="Left" Margin="107,5,0,0" Grid.ColumnSpan="2"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>