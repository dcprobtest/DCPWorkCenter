<Window x:Class="View_WPF.frmAdmin_Department"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department Management" Height="780" Width="900"
        WindowStartupLocation="CenterScreen" Background="#FFF7F7F7"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="Black"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="10" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                                        <GradientStop Color="#00FF00" Offset="0.4"/>
                                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                                        <GradientStop Color="#0000FF" Offset="0.8"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0B0D" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse IsHitTestVisible="False" Fill="#156200EE" Width="734" Height="694" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-124,-100">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Department Registration" FontSize="32" Foreground="Black" Margin="0,0,0,30" HorizontalAlignment="Center" FontWeight="Bold"/>

            <Border Grid.Row="1" Width="750" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="20" Padding="2">
                <Border.Background>
                    <LinearGradientBrush x:Name="MainGradient" StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF0000" Offset="0.0"/>
                        <GradientStop Color="#FFFF00" Offset="0.2"/>
                        <GradientStop Color="#00FF00" Offset="0.4"/>
                        <GradientStop Color="#00FFFF" Offset="0.6"/>
                        <GradientStop Color="#0000FF" Offset="0.8"/>
                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Border Background="#FFEBEAE9" CornerRadius="18" Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Department Code" Foreground="#FF1C1B1B" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDeptCode" Grid.Row="1" Text="{Binding Dept.DeptCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" MaxLength="10"/>
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Entry Date" Foreground="#FF1A1919" Margin="0,0,0,5"/>
                            <DatePicker Grid.Row="1" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" SelectedDate="{Binding Dept.EntryDate, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Description" Foreground="#FF1C1B1B" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDescription" Grid.Row="1" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" 
                                     Text="{Binding Dept.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Responsibility" Foreground="#FF1C1B1B" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtResponsibility" Grid.Row="1" Text="{Binding Dept.Responsiblity, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="0" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Start Date" Foreground="#FF1C1B1B" Margin="0,0,0,5"/>
                            <DatePicker Grid.Row="1" HorizontalAlignment="Stretch" SelectedDate="{Binding Dept.StartDate, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Grid.Row="3" Grid.Column="1" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="End Date" Foreground="#FF1C1B1B" Margin="0,0,0,5"/>
                            <DatePicker Grid.Row="1" HorizontalAlignment="Stretch" SelectedDate="{Binding Dept.EndDate, Mode=TwoWay}"/>
                        </Grid>

                        <CheckBox Grid.Row="4" Grid.Column="0" Margin="15,20,0,20" VerticalAlignment="Center" IsChecked="{Binding IsActive, Mode=TwoWay}">
                            <TextBlock Text="Active Status" Foreground="Black" FontSize="16" Margin="10,0,0,0"/>
                        </CheckBox>

                        <Button x:Name="btnSaveDepartment" Grid.Row="5" Grid.ColumnSpan="2" Height="50" Width="250" 
                                Content="SAVE DEPARTMENT" 
                                Style="{StaticResource RainbowButtonStyle}" 
                                Margin="0,20,0,0"
                                Command="{Binding SaveCommand}"/>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>