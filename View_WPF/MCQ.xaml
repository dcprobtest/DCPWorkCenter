<Window x:Class="View_WPF.MCQ"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="DCP MCQ Test" Height="680" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Window.Resources>
        <!-- ক্লিন হোয়াইট বেস টেক বাটন স্টাইল (ব্লু গ্লো) -->
        <Style x:Key="TechWhiteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#007ACC" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glowEffect" BlurRadius="6" Color="#007ACC" Opacity="0.2" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00FFCC"/>
                                <Setter Property="Foreground" Value="#00FFCC"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="btnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect" Storyboard.TargetProperty="BlurRadius" To="6" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ডেঞ্জার / রেড অ্যাকশন বাটন স্টাইল -->
        <Style x:Key="TechRedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#D32F2F" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#D32F2F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- সাকসেস / গ্রিন সাবমিট বাটন স্টাইল -->
        <Style x:Key="TechGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#388E3C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="#388E3C" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#388E3C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- কোশ্চেন প্যালেট নম্বর বাটন স্টাইল -->
        <Style x:Key="PaletteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Bar Header & Timer -->
            <RowDefinition Height="Auto"/>
            <!-- Top Instruction Indicators -->
            <RowDefinition Height="*"/>
            <!-- Workspace Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Sticky Control Panel -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Top Bar Header & Timer -->
        <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15,10" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Color="#DDDDDD" ShadowDepth="1" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Left Content: Title -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DCP TEST" FontSize="18" FontWeight="Bold" Foreground="#222222"/>
                    <TextBlock Grid.Column="1" Text=" - Section Wise Practice" FontSize="14" Foreground="#777777" VerticalAlignment="Center" Margin="5,2,0,0"/>
                </Grid>

                <!-- Middle Content: Timer -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Time Left" FontSize="11" Foreground="#555555" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="{Binding TimeLeftString, TargetNullValue='00 : 59 : 32'}" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Right Content: Info -->
                <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ID No : 100181161242163" FontSize="11" FontWeight="SemiBold" Foreground="#444444" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="[ Candidate Name ]" FontSize="12" Foreground="#666666" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 1: Instruction Notice Bar -->
        <Border Grid.Row="1" Background="#FFFDE7" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Text="SYMBOLS &amp; INSTRUCTIONS: Please note that this is a simulated interface generated for your stored database MCQs practice purposes." FontSize="12" Foreground="#F57F17" FontWeight="Medium"/>
        </Border>

        <!-- ROW 2: Main Workspace Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE PANEL -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Part Tabs -->
                    <RowDefinition Height="*"/>
                    <!-- Number Grid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Summary Status -->
                </Grid.RowDefinitions>

                <!-- Tab UniformGrid -->
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <Button Content="PART-A" Background="#007ACC" Foreground="White" FontSize="11" FontWeight="Bold" Height="28" Margin="2"/>
                    <Button Content="PART-B" Background="#388E3C" Foreground="White" FontSize="11" FontWeight="Bold" Height="28" Margin="2"/>
                    <Button Content="PART-C" Background="#007ACC" Foreground="White" FontSize="11" FontWeight="Bold" Height="28" Margin="2"/>
                    <Button Content="PART-D" Background="#007ACC" Foreground="White" FontSize="11" FontWeight="Bold" Height="28" Margin="2"/>
                </UniformGrid>

                <!-- Palette Outer Border -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="General Awareness / Questions" FontSize="12" FontWeight="SemiBold" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="26" Style="{StaticResource PaletteButtonStyle}"/>
                                <Button Content="27" Style="{StaticResource PaletteButtonStyle}" Background="#388E3C"/>
                                <Button Content="28" Style="{StaticResource PaletteButtonStyle}" Background="#388E3C"/>
                                <Button Content="29" Style="{StaticResource PaletteButtonStyle}"/>
                                <Button Content="30" Style="{StaticResource PaletteButtonStyle}" Background="#388E3C"/>
                                <Button Content="31" Style="{StaticResource PaletteButtonStyle}" Background="#F57F17"/>
                                <Button Content="32" Style="{StaticResource PaletteButtonStyle}" Background="#388E3C"/>
                                <Button Content="33" Style="{StaticResource PaletteButtonStyle}" Background="#388E3C"/>
                                <Button Content="34" Style="{StaticResource PaletteButtonStyle}" BorderBrush="#00FFCC" BorderThickness="1.5"/>
                                <Button Content="35" Style="{StaticResource PaletteButtonStyle}"/>
                                <Button Content="36" Style="{StaticResource PaletteButtonStyle}"/>
                                <Button Content="37" Style="{StaticResource PaletteButtonStyle}"/>
                                <Button Content="38" Style="{StaticResource PaletteButtonStyle}"/>
                                <Button Content="39" Style="{StaticResource PaletteButtonStyle}"/>
                                <Button Content="40" Style="{StaticResource PaletteButtonStyle}"/>
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Analysis Summary Box -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PART-B Analysis" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
                        <Separator Grid.Row="1" Background="#EEEEEE"/>

                        <Grid Grid.Row="2">
                            <TextBlock Text="Answered:" FontSize="12" Foreground="#555555" HorizontalAlignment="Left"/>
                            <TextBlock Text="5" FontSize="12" FontWeight="Bold" Foreground="#388E3C" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <TextBlock Text="Not Answered:" FontSize="12" Foreground="#555555" HorizontalAlignment="Left"/>
                            <TextBlock Text="20" FontSize="12" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT MAIN PANEL -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header Controls -->
                        <RowDefinition Height="Auto"/>
                        <!-- Question Text -->
                        <RowDefinition Height="*"/>
                        <!-- Options Selection -->
                    </Grid.RowDefinitions>

                    <!-- Header Grid Layout -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Info -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Question : " FontSize="16" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentMCQ.MCQID, TargetNullValue='34'}" FontSize="16" FontWeight="Bold" Foreground="#007ACC"/>
                        </Grid>

                        <!-- Right Control Buttons -->
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Mark for Review &amp; Next" Style="{StaticResource TechWhiteButtonStyle}" Command="{Binding MarkReviewCommand}" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Save &amp; Next" Style="{StaticResource TechWhiteButtonStyle}" Command="{Binding SaveNextCommand}"/>
                        </Grid>
                    </Grid>

                    <!-- Question Body -->
                    <TextBlock Grid.Row="1" Text="{Binding CurrentMCQ.Question, TargetNullValue='Which of the following Table Tennis World Championship events was held in India?'}" 
                               FontSize="15" Foreground="#222222" TextWrapping="Wrap" LineHeight="22" FontWeight="Medium" Margin="0,0,0,25"/>

                    <!-- Options Grid Layout instead of StackPanel -->
                    <Grid Grid.Row="2" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <RadioButton Grid.Row="0" GroupName="McqOptions" Margin="0,0,0,14" FontSize="14" Foreground="#444444"
                                     IsChecked="{Binding IsOpt1Checked}" Content="{Binding CurrentMCQ.Ans1, TargetNullValue='19th World Championships, 1952'}"/>

                        <RadioButton Grid.Row="1" GroupName="McqOptions" Margin="0,0,0,14" FontSize="14" Foreground="#444444"
                                     IsChecked="{Binding IsOpt2Checked}" Content="{Binding CurrentMCQ.Ans2, TargetNullValue='17th World Championships, 1950'}"/>

                        <RadioButton Grid.Row="2" GroupName="McqOptions" Margin="0,0,0,14" FontSize="14" Foreground="#444444"
                                     IsChecked="{Binding IsOpt3Checked}" Content="{Binding CurrentMCQ.Ans3, TargetNullValue='20th World Championships, 1953'}"/>

                        <RadioButton Grid.Row="3" GroupName="McqOptions" Margin="0,0,0,14" FontSize="14" Foreground="#444444"
                                     IsChecked="{Binding IsOpt4Checked}" Content="{Binding CurrentMCQ.Ans4, TargetNullValue='18th World Championships, 1951'}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 3: Bottom Sticky Panel -->
        <Grid Grid.Row="3" Background="Transparent" Margin="0,5,0,0">
            <Button Content="Clear Response" Style="{StaticResource TechRedButtonStyle}" Command="{Binding ClearResponseCommand}" HorizontalAlignment="Left"/>
            <Button Content="Submit Test" Style="{StaticResource TechGreenButtonStyle}" Command="{Binding SubmitCommand}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>