<Window x:Class="View_WPF.frmClass_SourseAssign"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Source Assign Management" 
        Height="780" Width="800"
        MinHeight="650" MinWidth="500"
        WindowStartupLocation="CenterScreen" 
        Background="White"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0080FF"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot">
                            <Border CornerRadius="12" Padding="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BtnRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0080" Offset="0.0"/>
                                        <GradientStop Color="#FF8C00" Offset="0.3"/>
                                        <GradientStop Color="#40E0D0" Offset="0.7"/>
                                        <GradientStop Color="#9370DB" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#1A1A1D" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BtnRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Fill="#100066FF" Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-200">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,10,0,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SourceAssign Table" FontSize="14" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="DATABASE SOURCE MANAGEMENT" FontSize="26" FontWeight="ExtraBold" Foreground="#2D2D30" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Rectangle Grid.Row="2" Width="60" Height="4" Fill="#FF0080" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" MaxWidth="700" HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="30" Padding="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform x:Name="MainBorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                            <GradientStop Color="#00FF00" Offset="0.4"/>
                            <GradientStop Color="#00FFFF" Offset="0.6"/>
                            <GradientStop Color="#0000FF" Offset="0.8"/>
                            <GradientStop Color="#FF00FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="MainBorderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:15" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <Border Background="#F9F9F9" CornerRadius="28" Padding="20,30">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="10,0,10,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Course Assign ID:" Foreground="#888" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,5"/>
                                <TextBox Grid.Row="1" Text="{Binding CourseAssignId, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"/>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,15">
                                <Grid Margin="10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="USER ID (UID)" Foreground="#888" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,5"/>
                                    <TextBox x:Name="txtUID" Grid.Row="1" Text="{Binding Uid, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"/>
                                </Grid>
                                <Grid Margin="10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SUBJECT CODE" Foreground="#888" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,5"/>
                                    <TextBox x:Name="txtSubjectCode" Grid.Row="1" Text="{Binding SubjectCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                                </Grid>
                            </UniformGrid>

                            <Grid Grid.Row="2" Margin="10,0,10,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="SUBJECT NAME (For Folder: e.g. SQL, DOT NET)" Foreground="#888" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,5"/>
                                <TextBox x:Name="txtSubjectName" Grid.Row="1" Text="{Binding SubjectName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,0,15">
                                <Grid Margin="10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ENTRY BY UID" Foreground="#888" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,5"/>
                                    <TextBox x:Name="txtEntryByUID" Grid.Row="1" Text="{Binding EntryByUid, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"/>
                                </Grid>
                                <Grid Margin="10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="LAST UPDATE" Foreground="#888" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,5"/>
                                    <TextBox x:Name="txtLastUpdate" Grid.Row="1" Text="{Binding LastUpdate, StringFormat='dd-MMM-yyyy HH:mm'}" IsReadOnly="True" Background="#EEE"/>
                                </Grid>
                            </UniformGrid>

                            <Grid Grid.Row="4" Margin="10,0,10,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="VIDEO SOURCE FILE" Foreground="#888" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,5"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtVideoPath" Text="{Binding VideoPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F0F0F0"/>
                                    <Button x:Name="btnBrowse" Command="{Binding BrowseCommand}" Grid.Column="1" Content="..." Width="40" Margin="5,0,0,0" Background="#444" Foreground="White" BorderThickness="0"/>
                                </Grid>
                            </Grid>

                            <Border Grid.Row="5" Background="White" BorderBrush="#EEE" BorderThickness="1" CornerRadius="12" Padding="15,10" Margin="10,0,10,25">
                                <CheckBox x:Name="chkActivate" IsChecked="{Binding Activate}" VerticalContentAlignment="Center">
                                    <TextBlock Text="Set Record to Active Status" Foreground="#444" FontSize="14" Margin="10,0,0,0"/>
                                </CheckBox>
                            </Border>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnRefresh" 
                                        Command="{Binding RefreshCommand}"
                                        Content="REFRESH" 
                                        Height="50" 
                                        Margin="10,5" 
                                        Style="{StaticResource RainbowButtonStyle}"/>

                                <Button x:Name="btnSave" 
                                        Grid.Column="1"
                                        Command="{Binding SaveCommand}"
                                        Content="UPLOAD &amp; SAVE" 
                                        Height="50" 
                                        Style="{StaticResource RainbowButtonStyle}" 
                                        Margin="10,5"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>