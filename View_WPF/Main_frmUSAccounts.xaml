<Window x:Class="View_WPF.Main_frmUSAccounts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View_WPF"
        mc:Ignorable="d"
        Title="Accounts Management" 
        Height="850" Width="1450" 
        WindowState="Maximized" 
        Background="White">

    <Window.Resources>
        <Style x:Key="OptionCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CardContainer" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="GradientBorder" CornerRadius="25" Padding="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <LinearGradientBrush.RelativeTransform>
                                            <RotateTransform x:Name="BorderRotate" CenterX="0.5" CenterY="0.5" Angle="0" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#FF0000" Offset="0.0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.25"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFF" Offset="0.75"/>
                                        <GradientStop Color="#FF00FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="White" CornerRadius="22">
                                    <ContentPresenter />
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="TitleMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card1Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.1" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card2Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.2" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card3Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.3" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card4Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.4" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card5Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.5" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card6Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.6" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Card7Move" Storyboard.TargetProperty="Y" To="0" BeginTime="0:0:0.7" Duration="0:0:0.8">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Ellipse Fill="#222196F3" Width="800" Height="800" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-200,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="#159C27B0" Width="1000" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-200">
            <Ellipse.Effect>
                <BlurEffect Radius="150"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="US Accounts Management" FontSize="50" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,50">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleMove" Y="40"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <Button Grid.Column="0" Grid.Row="0" Margin="10" Style="{StaticResource OptionCardStyle}" x:Name="btnAccUSExpBub" Click="btnAccUSExpBub_Click">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card1Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="50" Width="50" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Path Fill="#FF5722" Data="M11,2V22C5.9,21.5 2,17.2 2,12C2,6.8 5.9,2.5 11,2M13,2C14.8,2.2 16.4,2.9 17.8,4L13,8.8V2M22,12C22,13.8 21.5,15.4 20.6,16.8L15.8,12H22M13,15.2L17.8,20C16.4,21.1 14.8,21.8 13,22V15.2Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Acc US Exp Bub" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="0" Margin="10" Style="{StaticResource OptionCardStyle}" x:Name="btnAccUSExpend">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card2Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="50" Width="50" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Path Fill="#F44336" Data="M2,21V19H20V21H2M20,8V5H7V8H20M20,12V9H10V12H20M20,16V13H13V16H20M2,4H5V17H2V4Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Acc US Expend" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Grid.Row="0" Margin="10" Style="{StaticResource OptionCardStyle}" x:Name="btnAccUSExpendHead" Click="btnAccUSExpendHead_Click">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card3Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="50" Width="50" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Path Fill="#607D8B" Data="M3,5H9V11H3V5M5,7V9H7V7H5M11,5H17V11H11V5M13,7V9H15V7H13M3,13H9V19H3V13M5,15V17H7V15H5M11,13H17V19H11V13M13,15V17H15V15H13M19,5V19H21V5H19Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Acc US Expend Head" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Grid>
                </Button>

                <Button Grid.Column="3" Grid.Row="0" Margin="10" Style="{StaticResource OptionCardStyle}" x:Name="btnAccUSExpenditure">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card4Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="50" Width="50" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Path Fill="#00796B" Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Acc US Expenditure" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Grid>
                </Button>

                <Button Grid.Column="0" Grid.Row="1" Margin="10" Style="{StaticResource OptionCardStyle}" x:Name="btnAccUSIncome">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card5Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="50" Width="50" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Path Fill="#2196F3" Data="M20,18H4V15H20M20,12H4V9H20M20,6H4V3H20M20,21H4V19H20M2,21V3H4V21H2M22,21H20V3H22V21Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Acc US Income" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Grid>
                </Button>

                <Button Grid.Column="1" Grid.Row="1" Margin="10" Style="{StaticResource OptionCardStyle}" x:Name="btnAccUSIncomeHead">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card6Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="50" Width="50" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Path Fill="#3F51B5" Data="M13,3V9H19L13,3M6,2H14L20,8V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2M12,18L16,14H13V10H11V14H8L12,18Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Acc US Income Head" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Grid.Row="1" Margin="10" Style="{StaticResource OptionCardStyle}" x:Name="btnAccUSIncSub">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="Card7Move" Y="100"/>
                    </Button.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Height="50" Width="50" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <Path Fill="#9C27B0" Data="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="Acc US Inc Sub" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Grid>
                </Button>

            </Grid>
        </Grid>
    </Grid>
</Window>