<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ModelView_MAUI;assembly=ModelView_MAUI"
             x:Class="View_MAUI.frmAccUSIncSub"
             Title="US Income Sub Head Setup"
             BackgroundColor="#F0F2F5">

    <ContentPage.Resources>
        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="HeightRequest" Value="45"/>
            <Setter Property="WidthRequest" Value="100"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BackgroundColor" Value="#62309C"/>
        </Style>

        <Style x:Key="ModernEntry" TargetType="Entry">
            <Setter Property="HeightRequest" Value="32"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <vm:AccUSIncSubViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <Grid Margin="15">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="3" BackgroundColor="White" Padding="2">
                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF4500" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.3"/>
                        <GradientStop Color="#00FF00" Offset="0.6"/>
                        <GradientStop Color="#00BFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Stroke>

                <Grid Margin="15" RowDefinitions="*, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="320, *" ColumnSpacing="10">

                        <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="20">
                            <VerticalStackLayout Spacing="15">
                                <Label Text="IncSub Code" FontAttributes="Bold" TextColor="Gray"/>
                                <Entry x:Name="txtIncSubCode" Style="{StaticResource ModernEntry}" Text="{Binding IncSubCode, Mode=TwoWay}"/>

                                <Label Text="Inc Code" FontAttributes="Bold" TextColor="Gray"/>
                                <Picker x:Name="cmbIncCode" Title="Select Inc Code" ItemsSource="{Binding IncCodeList}" SelectedItem="{Binding SelectedIncCode, Mode=TwoWay}"/>

                                <Label Text="Inc Detail" FontAttributes="Bold" TextColor="Gray"/>
                                <Entry x:Name="txtIncDetail" Style="{StaticResource ModernEntry}" Text="{Binding IncDetail, Mode=TwoWay}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 15" Padding="5">
                            <CollectionView x:Name="dgUSIncomeSub" 
                                            ItemsSource="{Binding USIncSubList}" 
                                            SelectedItem="{Binding SelectedUSIncSub, Mode=TwoWay}"
                                            SelectionMode="Single">
                                <CollectionView.Header>
                                    <Grid ColumnDefinitions="100, 80, *" BackgroundColor="#F9F9F9" Padding="5">
                                        <Label Text="IncSub Code" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="Inc Code" FontAttributes="Bold"/>
                                        <Label Grid.Column="2" Text="Income Detail" FontAttributes="Bold"/>
                                    </Grid>
                                </CollectionView.Header>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="100, 80, *" Padding="5" HeightRequest="35">
                                            <Label Text="{Binding IncSubCode}" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding IncCode}" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding IncDetail}" VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Grid.Column="0">
                            <Button Text="ADD" Style="{StaticResource RainbowButtonStyle}" Command="{Binding AddCommand}"/>
                            <Button Text="SAVE" Style="{StaticResource RainbowButtonStyle}" Command="{Binding SaveCommand}"/>
                            <Button Text="EDIT" Style="{StaticResource RainbowButtonStyle}" Command="{Binding EditCommand}"/>
                            <Button Text="EXIT" Style="{StaticResource RainbowButtonStyle}" Command="{Binding ExitCommand}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Entry x:Name="txtUID" WidthRequest="70" HeightRequest="32" IsReadOnly="True" BackgroundColor="#F0F0F0" Text="{Binding UID, Mode=TwoWay}"/>
                            <DatePicker x:Name="dtpEntryDate" Date="{Binding EntryDate, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>