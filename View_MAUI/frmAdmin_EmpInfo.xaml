<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.frmAdmin_EmpInfo"
             Title="Employee Information"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10,0,10,15"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Ellipse Fill="#15007AFF" WidthRequest="700" HeightRequest="700" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-250,-250,0" />

        <ScrollView VerticalOptions="Fill" HorizontalOptions="Fill">
            <Grid Margin="20" VerticalOptions="Start">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Text="Employee Information" FontSize="32" FontAttributes="Bold" TextColor="Black" Margin="0,0,0,30" HorizontalOptions="Center"/>

                <Border Grid.Row="1" WidthRequest="850" HorizontalOptions="Center" VerticalOptions="Start" StrokeShape="RoundRectangle 25,25,25,25" Padding="30" BackgroundColor="#FFEBEAE9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="User ID (UID)" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.UID}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="First Name" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.FName}" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Last Name" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.LName}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="Date of Birth (DOB)" TextColor="Gray" Margin="10,0,0,5"/>
                        <DatePicker Date="{Binding Emp.DOB}" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="10,0,10,15"/>

                        <Label Grid.Row="4" Grid.ColumnSpan="4" Text="Address Line 1" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.Address1}" Grid.Row="5" Grid.ColumnSpan="4"/>

                        <Label Grid.Row="6" Grid.ColumnSpan="4" Text="Address Line 2" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.Address2}" Grid.Row="7" Grid.ColumnSpan="4"/>

                        <Label Grid.Row="8" Grid.Column="0" Text="City" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.City}" Grid.Row="9" Grid.Column="0"/>
                        <Label Grid.Row="8" Grid.Column="1" Text="State" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.State}" Grid.Row="9" Grid.Column="1"/>
                        <Label Grid.Row="8" Grid.Column="2" Text="Zip" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.Zip}" Grid.Row="9" Grid.Column="2"/>
                        <Label Grid.Row="8" Grid.Column="3" Text="Country" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.Country}" Grid.Row="9" Grid.Column="3"/>

                        <Label Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Text="Phone" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.Phone}" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <Label Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="2" Text="Email" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.Email}" Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Text="Primary ID" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.PrimaryID}" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <Label Grid.Row="12" Grid.Column="2" Grid.ColumnSpan="2" Text="Secondary ID" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.SecondID}" Grid.Row="13" Grid.Column="2" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Text="Department Code" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.DeptCode}" Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2"/>
                        <Label Grid.Row="14" Grid.Column="2" Grid.ColumnSpan="2" Text="Designation Code" TextColor="Gray" Margin="10,0,0,5"/>
                        <Entry Text="{Binding Emp.DesigCode}" Grid.Row="15" Grid.Column="2" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="16" Grid.Column="0" Text="Entry Date" TextColor="Gray" Margin="10,0,0,5"/>
                        <DatePicker Date="{Binding Emp.EntryDate}" Grid.Row="17" Grid.Column="0" Margin="10,0,5,15"/>
                        <Label Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" Text="Start Date" TextColor="Gray" Margin="10,0,0,5"/>
                        <DatePicker Date="{Binding Emp.StartDate}" Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,0,5,15"/>
                        <Label Grid.Row="16" Grid.Column="3" Text="End Date" TextColor="Gray" Margin="10,0,0,5"/>
                        <DatePicker Date="{Binding Emp.EndDate}" Grid.Row="17" Grid.Column="3" Margin="5,0,10,15"/>

                        <CheckBox IsChecked="{Binding IsActive}" Grid.Row="18" Grid.ColumnSpan="4" HorizontalOptions="Start" Margin="10,0,0,15"/>
                        <Label Grid.Row="18" Grid.ColumnSpan="4" Text="Activate Employee Profile" TextColor="Black" VerticalOptions="Center" Margin="50,0,0,15"/>

                        <Button Command="{Binding SaveCommand}" Grid.Row="19" Grid.ColumnSpan="4" HeightRequest="50" WidthRequest="300" 
                                Text="SAVE EMPLOYEE INFO" BackgroundColor="Blue" TextColor="White" FontAttributes="Bold" Margin="0,20,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>