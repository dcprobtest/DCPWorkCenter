                    </VerticalStackLayout>
                </Border>

                <!-- Employee Info -->
                <Border Grid.Column="0" Grid.Row="1" WidthRequest="160" HeightRequest="200" StrokeShape="RoundRectangle 25" StrokeThickness="0" Background="White" Padding="10">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="OnEmployeeInfoTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#673AB7" Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,20V18C5,15.79 8.13,14 12,14C15.87,14 19,15.79 19,18V20H5M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" HorizontalOptions="Center" HeightRequest="65"/>
                        <Label Text="Employee Info" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
