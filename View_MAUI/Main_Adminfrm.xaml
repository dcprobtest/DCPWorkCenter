                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#E91E63" Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.33 4,18V20H20V18C20,15.67 14.67,14 12,14Z" HorizontalOptions="Center" HeightRequest="65"/>
                        <Label Text="Designation" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Doc Info -->
                <Border Grid.Column="2" Grid.Row="0" WidthRequest="160" HeightRequest="200" StrokeShape="RoundRectangle 25" StrokeThickness="0" Background="White" Padding="10">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="OnDocInfoTapped" />
                    </Border.GestureRecognizers>
