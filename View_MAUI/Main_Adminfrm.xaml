                    </VerticalStackLayout>
                </Border>

                <!-- Designation -->
                <Border Grid.Column="1" Grid.Row="0" WidthRequest="160" HeightRequest="200" StrokeShape="RoundRectangle 25" StrokeThickness="0" Background="White" Padding="10">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="OnDesignationTapped" />
