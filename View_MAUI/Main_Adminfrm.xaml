                <Border Grid.Column="1" Grid.Row="1" WidthRequest="160" HeightRequest="200" StrokeShape="RoundRectangle 25" StrokeThickness="0" Background="White" Padding="10">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="OnUserTableTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#009688" Data="M4,3H20A2,2 0 0,1 22,5V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V5A2,2 0 0,1 4,3M4,7V11H11V7H4M13,7V11H20V7H13M4,13V17H11V13H4M13,13V17H20V13H13Z" HorizontalOptions="Center" HeightRequest="65"/>
                        <Label Text="User Table" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Create Docx -->
                <Border Grid.Column="2" Grid.Row="1" WidthRequest="160" HeightRequest="200" StrokeShape="RoundRectangle 25" StrokeThickness="0" Background="White" Padding="10">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="OnCreateDocxTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#2B579A" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M15.2,19H13.8L12.9,15.1L12,19H10.6L9.1,13H10.5L11.5,17.4L12.4,13.4H13.5L14.4,17.4L15.4,13H16.7L15.2,19M13,9V3.5L18.5,9H13Z" HorizontalOptions="Center" HeightRequest="65"/>
