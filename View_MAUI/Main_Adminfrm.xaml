                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#2196F3" Data="M12,18.54L19.37,12.8L21,14.07L12,21.07L3,14.07L4.62,12.81L12,18.54M12,16L3,9L12,2L21,9L12,16M12,4.53L6.26,9L12,13.47L17.74,9L12,4.53Z" HorizontalOptions="Center" HeightRequest="65"/>
