            <Grid ColumnDefinitions="180, 180, 180, 180" RowDefinitions="220, 220" ColumnSpacing="20" RowSpacing="20" HorizontalOptions="Center">

                <!-- Department -->
                <Border Grid.Column="0" Grid.Row="0" WidthRequest="160" HeightRequest="200" StrokeShape="RoundRectangle 25" StrokeThickness="0" Background="White" Padding="10">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
