<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.frm_STEM"
             Title="STEM Management"
             BackgroundColor="#F5F6F7">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="RainbowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4B2B" Offset="0.0"/>
            <GradientStop Color="#FFB22C" Offset="0.3"/>
            <GradientStop Color="#2ECC71" Offset="0.6"/>
            <GradientStop Color="#3498DB" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="ThemeButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#667eea" Offset="0"/>
                        <GradientStop Color="#764ba2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Margin="15">
            <Border x:Name="MainBorder" Stroke="{StaticResource RainbowGradient}" StrokeThickness="3" StrokeShape="RoundRectangle 15" Background="White" Margin="2">

                <Grid ColumnDefinitions="1.5*, *" Margin="20">

                    <StackLayout Grid.Column="0" Spacing="20">
                        <CollectionView x:Name="dgSTEM" ItemsSource="{Binding STEMList}" HeightRequest="400" BackgroundColor="White">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80,80,50,50,50,60,60,70,70" Padding="5">
                                        <Label Grid.Column="0" Text="{Binding TransID}"/>
                                        <Label Grid.Column="1" Text="{Binding StudentUID}"/>
                                        <Label Grid.Column="2" Text="{Binding dYear}"/>
                                        <Label Grid.Column="3" Text="{Binding dMonth}"/>
                                        <Label Grid.Column="4" Text="{Binding Hours}"/>
                                        <Label Grid.Column="5" Text="{Binding Rate}"/>
                                        <Label Grid.Column="6" Text="{Binding SUI}"/>
                                        <Label Grid.Column="7" Text="{Binding Total}"/>
                                        <Label Grid.Column="8" Text="{Binding Paid}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Entry x:Name="txtTransID" Text="{Binding TransID}" Placeholder="Trans ID" IsReadOnly="True"/>
                            <Entry x:Name="txtStudentUID" Grid.Column="1" Text="{Binding StudentUID}" Placeholder="Student UID"/>
                        </Grid>

                        <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                            <Button Text="ADD" Command="{Binding AddCommand}" Style="{StaticResource ThemeButtonStyle}" Margin="5"/>
                            <Button Text="SAVE" Command="{Binding SaveCommand}" Style="{StaticResource ThemeButtonStyle}" Margin="5"/>
                            <Button Text="DELETE" Command="{Binding DeleteCommand}" Style="{StaticResource ThemeButtonStyle}" Margin="5"/>
                            <Button Text="EDIT" Command="{Binding EditCommand}" Style="{StaticResource ThemeButtonStyle}" Margin="5"/>
                            <Button Text="EXIT" Clicked="btnExit_Clicked" Style="{StaticResource ThemeButtonStyle}" Margin="5"/>
                        </FlexLayout>
                    </StackLayout>

                    <Frame Grid.Column="1" Margin="10" BackgroundColor="#F9F9F9" CornerRadius="10" IsVisible="{Binding IsInputVisible}">
                        <StackLayout Spacing="10">
                            <Entry x:Name="txtAdminUID" Text="{Binding AdminID}" Placeholder="Admin ID (Entry By)" IsReadOnly="True"/>

                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding IsActive}"/>
                                <Label Text="Is Active" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <StackLayout Spacing="5" Margin="0,10">
                                <Entry x:Name="txtYear" Text="{Binding dYear}" Placeholder="Year"/>
                                <Entry x:Name="txtMonth" Text="{Binding dMonth}" Placeholder="Month"/>
                                <DatePicker x:Name="dtpPayDate" Date="{Binding PayDate}"/>
                                <Entry x:Name="txtHours" Text="{Binding Hours}" Placeholder="Hours"/>
                                <Entry x:Name="txtRate" Text="{Binding Rate}" Placeholder="Rate"/>
                                <Entry x:Name="txtSUI" Text="{Binding SUI}" Placeholder="SUI"/>
                                <Entry x:Name="txtEmpTax" Text="{Binding EmpTax}" Placeholder="Emp Tax"/>
                                <Entry x:Name="txtPaid" Text="{Binding Paid}" Placeholder="Paid"/>
                                <Entry x:Name="txtTotal" Text="{Binding Total}" Placeholder="Total" BackgroundColor="#E8F4FD"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>