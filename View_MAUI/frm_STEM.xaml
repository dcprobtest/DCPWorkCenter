<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.frm_STEM"
             Title="STEM Management"
             BackgroundColor="#F5F6F7">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="RainbowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4B2B" Offset="0.0"/>
            <GradientStop Color="#FFB22C" Offset="0.3"/>
            <GradientStop Color="#2ECC71" Offset="0.6"/>
            <GradientStop Color="#3498DB" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="ButtonBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="WidthRequest" Value="100"/>
            <Setter Property="HeightRequest" Value="45"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalOptions" Value="FillAndExpand"/>
            <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Margin="15">
            <Border x:Name="MainBorder" Stroke="{StaticResource RainbowGradient}" StrokeThickness="3" StrokeShape="RoundRectangle 15" Background="White" Margin="2">
                <Grid ColumnDefinitions="1.5*, *" Margin="20">
                    <StackLayout Grid.Column="0" Spacing="20">
                        <CollectionView x:Name="dgSTEM" ItemsSource="{Binding STEMList}" HeightRequest="400" BackgroundColor="White">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80,80,50,50,50,60,60,70,70" Padding="5">
                                        <Label Grid.Column="0" Text="{Binding TransID}"/>
                                        <Label Grid.Column="1" Text="{Binding StudentUID}"/>
                                        <Label Grid.Column="2" Text="{Binding dYear}"/>
                                        <Label Grid.Column="3" Text="{Binding dMonth}"/>
                                        <Label Grid.Column="4" Text="{Binding Hours}"/>
                                        <Label Grid.Column="5" Text="{Binding Rate}"/>
                                        <Label Grid.Column="6" Text="{Binding SUI}"/>
                                        <Label Grid.Column="7" Text="{Binding Total}"/>
                                        <Label Grid.Column="8" Text="{Binding Paid}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Entry x:Name="txtTransID" Text="{Binding TransID}" Placeholder="Trans ID" IsReadOnly="True"/>
                            <Entry x:Name="txtStudentUID" Grid.Column="1" Text="{Binding StudentUID}" Placeholder="Student UID"/>
                        </Grid>

                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10" Margin="0,20,0,0">
                            <Border x:Name="AddBorder" Style="{StaticResource ButtonBorderStyle}" Stroke="Transparent">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="StartButtonAnimation" PointerExited="StopButtonAnimation"/>
                                </Border.GestureRecognizers>
                                <Button Command="{Binding AddCommand}" Text="ADD" Style="{StaticResource ButtonStyle}"/>
                            </Border>
                            <Border x:Name="SaveBorder" Style="{StaticResource ButtonBorderStyle}" Stroke="Transparent">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="StartButtonAnimation" PointerExited="StopButtonAnimation"/>
                                </Border.GestureRecognizers>
                                <Button Command="{Binding SaveCommand}" Text="SAVE" Style="{StaticResource ButtonStyle}"/>
                            </Border>
                            <Border x:Name="DeleteBorder" Style="{StaticResource ButtonBorderStyle}" Stroke="Transparent">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="StartButtonAnimation" PointerExited="StopButtonAnimation"/>
                                </Border.GestureRecognizers>
                                <Button Command="{Binding DeleteCommand}" Text="DELETE" Style="{StaticResource ButtonStyle}"/>
                            </Border>
                            <Border x:Name="EditBorder" Style="{StaticResource ButtonBorderStyle}" Stroke="Transparent">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="StartButtonAnimation" PointerExited="StopButtonAnimation"/>
                                </Border.GestureRecognizers>
                                <Button Command="{Binding EditCommand}" Text="EDIT" Style="{StaticResource ButtonStyle}"/>
                            </Border>
                            <Border x:Name="ExitBorder" Style="{StaticResource ButtonBorderStyle}" Stroke="Transparent">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="StartButtonAnimation" PointerExited="StopButtonAnimation"/>
                                </Border.GestureRecognizers>
                                <Button Clicked="btnExit_Clicked" Text="EXIT" Style="{StaticResource ButtonStyle}"/>
                            </Border>
                        </StackLayout>
                    </StackLayout>

                    <Border Grid.Column="1" Margin="10" BackgroundColor="#F9F9F9" StrokeThickness="0" StrokeShape="RoundRectangle 10" IsVisible="{Binding IsInputVisible}">
                        <StackLayout Spacing="10" Padding="15">
                            <Entry x:Name="txtAdminUID" Text="{Binding AdminID}" Placeholder="Admin ID (Entry By)" IsReadOnly="True"/>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding IsActive}"/>
                                <Label Text="Is Active" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <StackLayout Spacing="5">
                                <Entry x:Name="txtYear" Text="{Binding dYear}" Placeholder="Year"/>
                                <Entry x:Name="txtMonth" Text="{Binding dMonth}" Placeholder="Month"/>
                                <DatePicker x:Name="dtpPayDate" Date="{Binding PayDate}"/>
                                <Entry x:Name="txtHours" Text="{Binding Hours}" Placeholder="Hours"/>
                                <Entry x:Name="txtRate" Text="{Binding Rate}" Placeholder="Rate"/>
                                <Entry x:Name="txtSUI" Text="{Binding SUI}" Placeholder="SUI"/>
                                <Entry x:Name="txtEmpTax" Text="{Binding EmpTax}" Placeholder="Emp Tax"/>
                                <Entry x:Name="txtPaid" Text="{Binding Paid}" Placeholder="Paid"/>
                                <Entry x:Name="txtTotal" Text="{Binding Total}" Placeholder="Total" BackgroundColor="#E8F4FD"/>
                            </StackLayout>
                        </StackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>