<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.US_AccountsLogin"
             BackgroundColor="#F4F7F9"
             Title="US Accounts Security Login">

    <ContentPage.Resources>
        <Style x:Key="AccountButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="HeightRequest" Value="55"/>
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <Style x:Key="AccInputStyle" TargetType="Entry">
            <Setter Property="HeightRequest" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BackgroundColor" Value="White"/>
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="MainLayout">
        <Ellipse Fill="#33AF52DE" WidthRequest="600" HeightRequest="600" HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-250" TranslationY="-200" />
        <Ellipse Fill="#22007AFF" WidthRequest="500" HeightRequest="500" HorizontalOptions="End" VerticalOptions="End" TranslationX="200" TranslationY="150" />

        <Border x:Name="LoginCard" 
                WidthRequest="420" 
                HorizontalOptions="Center" 
                VerticalOptions="Center"
                BackgroundColor="White" 
                StrokeShape="RoundRectangle 30" 
                Padding="45" 
                Stroke="White">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="60" Opacity="0.15"/>
            </Border.Shadow>

            <VerticalStackLayout>
                <Label Text="US Accounts Login" FontSize="28" FontAttributes="Bold" TextColor="#1C1C1E" HorizontalOptions="Start"/>
                <Label Text="Administrative portal for US financial records." FontSize="13" TextColor="#8E8E93" Margin="0,10,0,35"/>

                <Label Text="ADMIN ID" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" Margin="5,0,0,8"/>
                <Entry x:Name="txtAccountUserID" Style="{StaticResource AccInputStyle}" IsReadOnly="True" />

                <Label Text="PASSWORD" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" Margin="5,20,0,8"/>
                <Entry x:Name="pbAccountPassword" Style="{StaticResource AccInputStyle}" IsPassword="True"/>

                <Button x:Name="btnAccountLogin" 
                        Text="SECURE ACCESS" 
                        Style="{StaticResource AccountButtonStyle}" 
                        Margin="0,35,0,0"
                        Clicked="btnAccountLogin_Clicked">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#007AFF" Offset="0"/>
                            <GradientStop Color="#5856D6" Offset="0.5"/>
                            <GradientStop Color="#AF52DE" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>