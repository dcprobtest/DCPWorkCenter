<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.MainWindow"
             BackgroundColor="#F4F6FA"
             NavigationPage.HasNavigationBar="False">

    <Grid IgnoreSafeArea="True">
        <!-- ব্যাকগ্রাউন্ড গ্লো ইফেক্ট -->
        <BoxView BackgroundColor="#1000FF0D" WidthRequest="450" HeightRequest="450" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-150,-100,0" CornerRadius="225"/>
        <BoxView BackgroundColor="#0DEE00EE" WidthRequest="500" HeightRequest="500" HorizontalOptions="Start" VerticalOptions="End" Margin="-150,0,0,-200" CornerRadius="250"/>

        <!-- মেইন কন্টেন্ট গ্রিড -->
        <Grid RowSpacing="35" Margin="40,50,40,40" VerticalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- টাইটেল -->
            <Label Grid.Row="0" 
                   Text="Select a Service" 
                   FontSize="36" 
                   FontAttributes="Bold" 
                   TextColor="#2C3E50" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"/>

            <!-- ১ম সারি (Row 1): অল্টারনেটিভ কলাম ডিক্লেয়ারেশন -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *, *" ColumnSpacing="20" HorizontalOptions="FillAndExpand">

                <!-- ১. Video Class Card -->
                <Border Grid.Column="0" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE714;" Color="#E74C3C" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="Video Class" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnVideoClass_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ২. Video Conference Card -->
                <Border Grid.Column="1" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE960;" Color="#9B59B6" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="Video Conference" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnVideoConference_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ৩. File Manager Card -->
                <Border Grid.Column="2" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE8B7;" Color="#3498DB" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="File Manager" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnFileManager_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ৪. Accounts Card -->
                <Border Grid.Column="3" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE77B;" Color="#2ECC71" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="Accounts" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnAccounts_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ৫. Scrum Card -->
                <Border Grid.Column="4" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xEA37;" Color="#E67E22" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="Scrum" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnScrum_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- ২য় সারি (Row 2): অল্টারনে티브 কলাম ডিক্লেয়ারেশন -->
            <Grid Grid.Row="2" ColumnDefinitions="*, *, *, *, *" ColumnSpacing="20" HorizontalOptions="FillAndExpand">

                <!-- ৬. Remote Access Card -->
                <Border Grid.Column="0" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE836;" Color="#1ABC9C" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="Remote Access" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnRemoteAccess_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ৭. Admin Forms Card -->
                <Border Grid.Column="1" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE713;" Color="#34495E" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="Admin Forms" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnAdminForms_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ৮. Class Forms Card -->
                <Border Grid.Column="2" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE814;" Color="#F1C40F" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="Class Forms" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnClassForms_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ৯. US Accounts Card -->
                <Border Grid.Column="3" HeightRequest="130" BackgroundColor="White" StrokeThickness="0" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid Padding="15" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="0" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource FontFamily="SegoeFluent" Glyph="&#xE8A1;" Color="#D35400" Size="44"/>
                            </Image.Source>
                        </Image>
                        <Label Grid.Row="1" Text="US Accounts" FontSize="15" FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center"/>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btnUSAccounts_Tapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <!-- ১০. ফিক্সড ব্ল্যাঙ্ক স্পেসার (এলাইনমেন্ট ধরে রাখার জন্য) -->
                <Border Grid.Column="4" HeightRequest="130" BackgroundColor="Transparent" StrokeThickness="0" Opacity="0" IsEnabled="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>