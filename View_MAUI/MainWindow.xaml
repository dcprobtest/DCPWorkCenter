<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.MainWindow"
             Title="DCP Dashboard"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Style x:Key="OptionCardStyle" TargetType="Border">
            <Setter Property="WidthRequest" Value="210"/>
            <Setter Property="HeightRequest" Value="150"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Stroke" Value="Transparent"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Ellipse Fill="#33007AFF" WidthRequest="1200" HeightRequest="1200" HorizontalOptions="Start" VerticalOptions="Start" TranslationX="-300" TranslationY="-300" />
        <Ellipse Fill="#266200EE" WidthRequest="1600" HeightRequest="1400" HorizontalOptions="End" VerticalOptions="End" TranslationX="400" TranslationY="400" />

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">

            <Label x:Name="lblTitle" Text="Select a Service" FontSize="56" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,40" />

            <FlexLayout JustifyContent="Center" Wrap="Wrap" MaximumWidthRequest="950">

                <Border x:Name="Card1" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="btnVideoClass_Tapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Image Source="video_class_icon.png" HeightRequest="70" WidthRequest="100"/>
                        <Label Text="Video Class" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card2" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Image Source="video_conference_icon.png" HeightRequest="70" WidthRequest="100"/>
                        <Label Text="Video Conference" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card3" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="btnFileManager_Tapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Image Source="file_manager_icon.png" HeightRequest="70" WidthRequest="100"/>
                        <Label Text="File Manager" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card4" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="btnAccounts_Tapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Path Fill="#007AFF" HeightRequest="65" WidthRequest="65" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Aspect="Uniform"/>
                        <Label Text="Accounts" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card5" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="btnScrum_Tapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Path Fill="#FF5722" HeightRequest="65" WidthRequest="65" Data="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,20V18C5,15.79 8.13,14 12,14C15.87,14 19,15.79 19,18V20H5M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Aspect="Uniform"/>
                        <Label Text="Scrum" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card6" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Image Source="remote_access_icon.png" HeightRequest="70" WidthRequest="100"/>
                        <Label Text="Remote Access" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card7" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="btnAdminForms_Tapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Path Fill="#FF9800" HeightRequest="65" WidthRequest="65" Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Aspect="Uniform"/>
                        <Label Text="Admin Forms" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card8" Style="{StaticResource OptionCardStyle}">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="btnClassForms_Tapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Path Fill="#BD00FF" HeightRequest="65" WidthRequest="65" Data="M19,3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.11,21 21,20.1 21,19V5C21,3.9 20.11,3 19,3M19,19H5V5H19V19M7,10H9V12H7V10M7,14H9V16H7V14M7,6H9V8H7V6M11,10H17V12H11V10M11,14H17V16H11V14M11,6H17V8H11V6Z" Aspect="Uniform"/>
                        <Label Text="Class Forms" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card4_US" Style="{StaticResource OptionCardStyle}" HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                        <TapGestureRecognizer Tapped="btnUSAccounts_Tapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Path Fill="#007AFF" HeightRequest="65" WidthRequest="65" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Aspect="Uniform"/>
                        <Label Text="US Accounts" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

            </FlexLayout>
        </VerticalStackLayout>

        <ImageButton x:Name="btnMessage" 
                     Source="message_icon.png" 
                     CornerRadius="30" 
                     BackgroundColor="#CC6200EE"
                     WidthRequest="60" HeightRequest="60"
                     HorizontalOptions="End" VerticalOptions="End"
                     Margin="30"
                     Clicked="btnMessage_Clicked" />
    </Grid>
</ContentPage>