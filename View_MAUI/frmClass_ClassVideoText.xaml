<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="View_MAUI.frmClass_ClassVideoText"
             Title="Class Video Text Information"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style x:Key="ModernEntry" TargetType="Entry">
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </ContentPage.Resources>

    <Grid Margin="20" ColumnDefinitions="*, 320" ColumnSpacing="25">

        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto, Auto">
            <Grid Grid.Row="0" ColumnDefinitions="1.2*, *, 100" ColumnSpacing="10" Margin="0,0,0,15">
                <Picker Title="Subject" ItemsSource="{Binding SubjectList}" ItemDisplayBinding="{Binding SubjectDesc}" SelectedItem="{Binding SelectedSubject}"/>
                <Picker Grid.Column="1" Title="Select Section" ItemsSource="{Binding SectionList}" ItemDisplayBinding="{Binding SectionDesc}" SelectedItem="{Binding SelectedSection}"/>
                <Entry Grid.Column="2" Placeholder="ID" Text="{Binding SelectedSection.SectionId}" IsReadOnly="True" BackgroundColor="#F1F5F9"/>
            </Grid>

            <Border Grid.Row="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Background="White">
                <CollectionView ItemsSource="{Binding ClassVideoList}" SelectedItem="{Binding SelectedItemInGrid}">
                    <CollectionView.Header>
                        <Grid BackgroundColor="#F3F4F6" Padding="10" ColumnDefinitions="100, 400, 80">
                            <Label Text="Class ID" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="Class Content" FontAttributes="Bold"/>
                            <Label Grid.Column="2" Text="Status" FontAttributes="Bold"/>
                        </Grid>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" ColumnDefinitions="100, 400, 80">
                                <Label Text="{Binding ClassID}"/>
                                <Label Grid.Column="1" Text="{Binding ClassContent}"/>
                                <Label Grid.Column="2" Text="{Binding Activate}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="100, *" ColumnSpacing="10" Margin="0,15,0,0">
                <Entry Placeholder="Class ID" Text="{Binding ClassVideo.ClassID}"/>
                <Entry Grid.Column="1" Placeholder="Enter Class Content..." Text="{Binding ClassVideo.ClassContent}"/>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                <Entry Placeholder="Video Server Path..." Text="{Binding ClassVideo.ClassPath}" IsReadOnly="True"/>
                <Button Grid.Column="1" Text="Browse Server" Command="{Binding BrowseCommand}" Margin="10,0,0,0"/>
            </Grid>
        </Grid>

        <VerticalStackLayout Grid.Column="1" Spacing="15">
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="View Timeline (Dates)" FontAttributes="Bold" TextColor="#8B5CF6" Padding="10"/>
                </toolkit:Expander.Header>
                <VerticalStackLayout Background="White" Padding="15" Spacing="5">
                    <Label Text="Entry By UID" FontSize="11" TextColor="Gray"/>
                    <Entry Text="{Binding ClassVideo.EntryByUID}" IsReadOnly="True" BackgroundColor="#F8FAFC"/>
                    <Label Text="Entry Date" FontSize="11" TextColor="Gray"/>
                    <Entry Text="{Binding ClassVideo.EntryDate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" BackgroundColor="#F8FAFC"/>
                    <Label Text="Start Date" FontSize="11" TextColor="Gray"/>
                    <Entry Text="{Binding ClassVideo.StartDate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" BackgroundColor="#F8FAFC"/>
                    <Label Text="End Date" FontSize="11" TextColor="Gray"/>
                    <Entry Text="{Binding ClassVideo.EndDate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" BackgroundColor="#F8FAFC"/>
                </VerticalStackLayout>
            </toolkit:Expander>

            <Button Text="Browse &amp; Prepare Video" Command="{Binding BrowseCommand}" BackgroundColor="#F0FDF4" TextColor="#166534" Style="{StaticResource BaseBtn}"/>
            <Button Text="Download" Command="{Binding DownloadCommand}" BackgroundColor="#EFF6FF" TextColor="#1E40AF" Style="{StaticResource BaseBtn}"/>
            <Button Text="Delete File" Command="{Binding DeleteFileCommand}" BackgroundColor="#FEF2F2" TextColor="#991B1B" Style="{StaticResource BaseBtn}"/>

            <HorizontalStackLayout Spacing="5" HorizontalOptions="Start" VerticalOptions="Center">
                <CheckBox IsChecked="{Binding IsActive}" VerticalOptions="Center"/>
                <Label Text="Active" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto, Auto" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0" Text="ADD" Command="{Binding AddCommand}" BackgroundColor="#10B981" TextColor="White" Style="{StaticResource BaseBtn}"/>
                <Button Grid.Row="0" Grid.Column="1" Text="SAVE" Command="{Binding SaveCommand}" BackgroundColor="#3B82F6" TextColor="White" Style="{StaticResource BaseBtn}"/>
                <Button Grid.Row="1" Grid.Column="0" Text="EDIT" Command="{Binding EditCommand}" BackgroundColor="#F59E0B" TextColor="White" Style="{StaticResource BaseBtn}"/>
                <Button Grid.Row="1" Grid.Column="1" Text="EXIT" Command="{Binding ExitCommand}" BackgroundColor="#64748B" TextColor="White" Style="{StaticResource BaseBtn}"/>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>