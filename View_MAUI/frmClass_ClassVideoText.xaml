<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.View_MAUI.ClassVideoTextView"
             Title="Class Video Management"
             BackgroundColor="#1E1E24">

    <!-- প্রধান লেআউট - কোনো StackPanel ব্যবহার করা হয়নি -->
    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*" Padding="20">

        <!-- হেড সেকশন (Row 0) -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <Label Grid.Column="0" 
                   Text="CLASS VIDEO SETUP" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#00FFCC"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1" 
                    Text="EXIT" 
                    Command="{Binding ExitCommand}" 
                    BackgroundColor="#FF3B30" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    WidthRequest="100"/>
        </Grid>

        <!-- মূল কন্টেন্ট এরিয়া (Row 1) - দুটি ভাগে বিভক্ত (ফর্ম এবং টেবিল/ভিউ) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 1.2*" ColumnSpacing="20">

            <!-- বাম পাশ: ডাটা এন্ট্রি ফর্ম -->
            <Border Grid.Column="0" StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="#2A2A32">
                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00FFCC" Offset="0.0" />
                        <GradientStop Color="#9900FF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Stroke>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="15">

                    <!-- Subject Picker -->
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="5">
                        <Label Grid.Row="0" Text="Select Subject" TextColor="White"/>
                        <Picker Grid.Row="1" 
                                ItemsSource="{Binding SubjectList}" 
                                ItemDisplayBinding="{Binding SubjectDesc}" 
                                SelectedItem="{Binding SelectedSubject}"
                                Title="-- Choose Subject --" TextColor="White" TitleColor="Gray" BackgroundColor="#1E1E24"/>
                    </Grid>

                    <!-- Section Picker -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="5">
                        <Label Grid.Row="0" Text="Select Section" TextColor="White"/>
                        <Picker Grid.Row="1" 
                                ItemsSource="{Binding SectionList}" 
                                ItemDisplayBinding="{Binding SectionDesc}" 
                                SelectedItem="{Binding SelectedSection}"
                                Title="-- Choose Section --" TextColor="White" TitleColor="Gray" BackgroundColor="#1E1E24"/>
                    </Grid>

                    <!-- Class Content Input -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="5">
                        <Label Grid.Row="0" Text="Class Content / Title" TextColor="White"/>
                        <Entry Grid.Row="1" Text="{Binding ClassVideo.ClassContent}" Placeholder="Enter content title" TextColor="White" PlaceholderColor="Gray" BackgroundColor="#1E1E24"/>
                    </Grid>

                    <!-- File Browser Section -->
                    <Grid Grid.Row="3" ColumnDefinitions="*, Auto" ColumnSpacing="10" RowDefinitions="Auto, Auto" RowSpacing="5">
                        <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Video File Path" TextColor="White"/>
                        <Entry Grid.Row="1" Grid.Column="0" Text="{Binding ClassVideo.ClassPath}" IsReadOnly="True" TextColor="White" BackgroundColor="#1E1E24"/>
                        <Button Grid.Row="1" Grid.Column="1" Text="Browse" Command="{Binding BrowseCommand}" BackgroundColor="#9900FF" TextColor="White"/>
                    </Grid>

                    <!-- Date Pickers -->
                    <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="5">
                            <Label Grid.Row="0" Text="Start Date" TextColor="White"/>
                            <DatePicker Grid.Row="1" Date="{Binding ClassVideo.StartDate}" TextColor="White" BackgroundColor="#1E1E24"/>
                        </Grid>
                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="5">
                            <Label Grid.Row="0" Text="End Date" TextColor="White"/>
                            <DatePicker Grid.Row="1" Date="{Binding ClassVideo.EndDate}" TextColor="White" BackgroundColor="#1E1E24"/>
                        </Grid>
                    </Grid>

                    <!-- Active Checkbox -->
                    <Grid Grid.Row="5" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsActive}" Color="#00FFCC"/>
                        <Label Grid.Column="1" Text="Mark as Active" TextColor="White" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="6" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="RESET" Command="{Binding AddCommand}" BackgroundColor="#555555" TextColor="White" FontAttributes="Bold"/>
                        <Button Grid.Column="1" Text="SAVE VIDEO" Command="{Binding SaveCommand}" BackgroundColor="#00FFCC" TextColor="#1E1E24" FontAttributes="Bold"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ডান পাশ: ডেটা গ্রিড / লিস্ট ভিউ -->
            <Grid Grid.Column="1" RowDefinitions="*, Auto" RowSpacing="15">

                <!-- CollectionView (Data Grid বিকল্প) - StrokeColor পরিবর্তন করে Stroke করা হয়েছে -->
                <Border Grid.Row="0" StrokeThickness="1" Stroke="#444" BackgroundColor="#2A2A32" StrokeShape="RoundRectangle 8">
                    <CollectionView ItemsSource="{Binding ClassVideoList}" 
                                    SelectedItem="{Binding SelectedItemInGrid}" 
                                    SelectionMode="Single">
                        <CollectionView.Header>
                            <!-- টেবিল হেডার -->
                            <Grid ColumnDefinitions="2*, 3*, 2*" BackgroundColor="#1E1E24" Padding="10">
                                <Label Grid.Column="0" Text="ID" FontAttributes="Bold" TextColor="#00FFCC"/>
                                <Label Grid.Column="1" Text="Content Title" FontAttributes="Bold" TextColor="#00FFCC"/>
                                <Label Grid.Column="2" Text="Status" FontAttributes="Bold" TextColor="#00FFCC"/>
                            </Grid>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*, 3*, 2*" Padding="10">
                                    <!-- সেকশনগুলোর ভিজ্যুয়াল স্টেট গ্রুপ (সিলেকশন হাইলাইট করার জন্য) -->
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#3D3D4C" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <!-- Model_MAUI:Text ফিক্স করে স্ট্যান্ডার্ড Text প্রপার্টি দেওয়া হয়েছে -->
                                    <Label Grid.Column="0" Text="{Binding ClassID}" TextColor="White"/>
                                    <Label Grid.Column="1" Text="{Binding ClassContent}" TextColor="White"/>
                                    <Label Grid.Column="2" Text="{Binding Activate}" TextColor="White"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- গ্রিড আইটেম অ্যাকশন বাটনসমূহ -->
                <Grid Grid.Row="1" ColumnDefinitions="*, *, *" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="EDIT SELECTED" Command="{Binding EditCommand}" BackgroundColor="#007AFF" TextColor="White" FontAttributes="Bold"/>
                    <Button Grid.Column="1" Text="DOWNLOAD" Command="{Binding DownloadCommand}" BackgroundColor="#34C759" TextColor="White" FontAttributes="Bold"/>
                    <Button Grid.Column="2" Text="DELETE" Command="{Binding DeleteFileCommand}" BackgroundColor="#FF3B30" TextColor="White" FontAttributes="Bold"/>
                </Grid>
            </Grid>

        </Grid>

        <!-- ফুটার সেকশন (Row 2) -->
        <Label Grid.Row="2" Text="Powered by DCP WorkCenter" TextColor="Gray" HorizontalOptions="Center" Margin="0,15,0,0"/>
    </Grid>
</ContentPage>