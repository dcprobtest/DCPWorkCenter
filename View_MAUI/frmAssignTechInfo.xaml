<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.frmAssignTechInfo"
             Title="Assign Tech Info Management"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderColor" Value="DeepSkyBlue"/>
            <Setter Property="BorderWidth" Value="2"/>
            <Setter Property="HeightRequest" Value="45"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Ellipse Fill="#15007AFF" WidthRequest="700" HeightRequest="700" 
                 HorizontalOptions="End" VerticalOptions="Start" 
                 Margin="0,-250,-250,0" Opacity="0.3"/>

        <ScrollView>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Text="Assign Tech Information Management" FontSize="30" FontAttributes="Bold" 
                       TextColor="#FF0A0909" Margin="0,0,0,25" HorizontalOptions="Center"/>

                <Border Grid.Row="1" StrokeShape="RoundRectangle 25" Padding="2" StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0000" Offset="0.0"/>
                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                            <GradientStop Color="#00FF00" Offset="0.4"/>
                            <GradientStop Color="#00FFFF" Offset="0.6"/>
                            <GradientStop Color="#0000FF" Offset="0.8"/>
                            <GradientStop Color="#FF00FF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border BackgroundColor="#FFEBEAE9" StrokeShape="RoundRectangle 23" Padding="25">
                        <Grid ColumnDefinitions="150, 20, 150, 30, *" 
                              RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">

                            <Label Grid.Row="0" Grid.Column="0" Text="Assign Tech Info ID" TextColor="#555555" FontAttributes="Bold"/>
                            <Entry Text="{Binding AssignTechInfoID}" IsReadOnly="True" Grid.Row="1" Grid.Column="0"/>

                            <Label Grid.Row="0" Grid.Column="2" Text="Assign ID" TextColor="#555555" FontAttributes="Bold"/>
                            <Entry Text="{Binding AssignID}" Grid.Row="1" Grid.Column="2"/>

                            <Label Grid.Row="2" Grid.Column="0" Text="Scrum ID" TextColor="#555555" FontAttributes="Bold"/>
                            <Picker ItemsSource="{Binding ScrumList}" SelectedItem="{Binding ScrumID}" Grid.Row="3" Grid.Column="0"/>

                            <Label Grid.Row="2" Grid.Column="2" Text="Entry By UID" TextColor="#555555" FontAttributes="Bold"/>
                            <Entry Text="{Binding EntryByUID}" IsReadOnly="True" Grid.Row="3" Grid.Column="2"/>

                            <Label Grid.Row="4" Grid.Column="0" Text="Entry Date" TextColor="#555555" FontAttributes="Bold"/>
                            <DatePicker Date="{Binding EntryDate}" Grid.Row="5" Grid.Column="0"/>

                            <CheckBox IsChecked="{Binding IsActivated}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" VerticalOptions="Center"/>
                            <Label Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="Activate Information" VerticalOptions="Center" Margin="40,0,0,0" TextColor="Black" FontAttributes="Bold"/>

                            <Label Grid.Row="0" Grid.Column="4" Text="Tech Information List" TextColor="#555555" FontAttributes="Bold"/>
                            <Border Grid.Row="1" Grid.RowSpan="6" Grid.Column="4" Stroke="#CCCCCC" StrokeThickness="1" StrokeShape="RoundRectangle 8" Background="White">
                                <CollectionView ItemsSource="{Binding TechInfoList}" SelectedItem="{Binding SelectedTechInfo}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding ScrumID, StringFormat='Scrum ID: {0}'}" Padding="10" TextColor="Black"/>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>

                            <HorizontalStackLayout Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" Spacing="15" Margin="0,10,0,0">
                                <Button Text="ADD" Command="{Binding AddCommand}" Style="{StaticResource RainbowButtonStyle}" WidthRequest="100"/>
                                <Button Text="SAVE" Command="{Binding SaveCommand}" Style="{StaticResource RainbowButtonStyle}" WidthRequest="100"/>
                                <Button Text="EDIT" Command="{Binding EditCommand}" Style="{StaticResource RainbowButtonStyle}" WidthRequest="100"/>
                                <Button Text="EXIT" Command="{Binding ExitCommand}" Style="{StaticResource RainbowButtonStyle}" WidthRequest="100"/>
                            </HorizontalStackLayout>

                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>