<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ModelView_MAUI;assembly=ModelView_MAUI"
             x:Class="View_MAUI.frmAccIncomeHead"
             Title="Income Head Setup"
             BackgroundColor="#F4F7F9">

    <ContentPage.Resources>
        <Style x:Key="PremiumButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="HeightRequest" Value="35"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BackgroundColor" Value="#764ba2"/>
        </Style>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <vm:AccIncomeHeadViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <Grid Margin="12" x:Name="MainGrid">
            <Border StrokeShape="RoundRectangle 10" StrokeThickness="3" BackgroundColor="White" Padding="2">
                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF4B2B" Offset="0"/>
                        <GradientStop Color="#FFB22C" Offset="0.3"/>
                        <GradientStop Color="#2ECC71" Offset="0.6"/>
                        <GradientStop Color="#3498DB" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Stroke>

                <Grid RowDefinitions="*, Auto" Margin="10">
                    <Grid Grid.Row="0" ColumnDefinitions="260, *" ColumnSpacing="10" Margin="0,0,0,10" x:Name="TopSection">

                        <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Inc Code" FontAttributes="Bold" FontSize="12" TextColor="Gray"/>
                                <Entry x:Name="txtIncCode" HeightRequest="35" Text="{Binding IncCode, Mode=TwoWay}"/>

                                <Label Text="Inc Detail" FontAttributes="Bold" FontSize="12" TextColor="Gray"/>
                                <Entry x:Name="txtIncDetail" HeightRequest="35" Text="{Binding IncDetail, Mode=TwoWay}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="5">
                            <CollectionView x:Name="dgIncomes" 
                                            ItemsSource="{Binding IncomeList}" 
                                            SelectedItem="{Binding SelectedIncome, Mode=TwoWay}"
                                            SelectionMode="Single">
                                <CollectionView.Header>
                                    <Grid ColumnDefinitions="80, *" BackgroundColor="#EEE" Padding="5">
                                        <Label Text="Inc Code" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="Income Detail" FontAttributes="Bold"/>
                                    </Grid>
                                </CollectionView.Header>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="80, *" Padding="5" HeightRequest="30">
                                            <Label Text="{Binding IncCode}" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding IncDetail}" VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" x:Name="ButtonSection">
                        <HorizontalStackLayout HorizontalOptions="Start">
                            <Button Text="ADD" Style="{StaticResource PremiumButtonStyle}" Command="{Binding AddCommand}"/>
                            <Button Text="SAVE" Style="{StaticResource PremiumButtonStyle}" Command="{Binding SaveCommand}"/>
                            <Button Text="EDIT" Style="{StaticResource PremiumButtonStyle}" Command="{Binding EditCommand}"/>
                            <Button Text="EXIT" Style="{StaticResource PremiumButtonStyle}" Command="{Binding ExitCommand}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Entry x:Name="txtUid" WidthRequest="80" IsReadOnly="True" BackgroundColor="#F0F0F0" Text="{Binding UID}"/>
                            <DatePicker x:Name="dtEntryDate" Date="{Binding EntryDate, Mode=TwoWay}"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>