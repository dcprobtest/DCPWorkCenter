<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.Login"
             Title="Login"
             BackgroundColor="White">

    <Grid>
        <Ellipse Fill="#22007AFF" WidthRequest="500" HeightRequest="500" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-200,-150,0" />
        <Ellipse Fill="#156200EE" WidthRequest="400" HeightRequest="400" HorizontalOptions="Start" VerticalOptions="End" Margin="-100,0,0,-150" />

        <Border WidthRequest="400" VerticalOptions="Center" HorizontalOptions="Center" 
                BackgroundColor="#FFDFDFDF" Stroke="#252527" StrokeThickness="1" 
                Padding="40" StrokeShape="RoundRectangle 24">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.6" Radius="50" Offset="0,0"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">
                <Label Text="Welcome To DCP" FontSize="30" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>
                <Label Text="Secure Login Portal" TextColor="#FF3C3C40" HorizontalOptions="Center" FontSize="14" Margin="0,0,0,20"/>

                <VerticalStackLayout Spacing="10">
                    <Label Text="USERID" FontSize="10" FontAttributes="Bold" TextColor="#555557" Margin="5,0,0,0"/>
                    <Entry x:Name="txtUserId" HeightRequest="45" BackgroundColor="White" Placeholder="Enter User ID"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="PASSWORD" FontSize="10" FontAttributes="Bold" TextColor="#555557" Margin="5,0,0,0"/>
                    <Entry x:Name="txtPassword" IsPassword="True" HeightRequest="45" BackgroundColor="#FFFBFBFF" Placeholder="Enter Password"/>
                </VerticalStackLayout>

                <Button x:Name="btnAuthenticate" Text="AUTHENTICATE" 
                        HeightRequest="50" BackgroundColor="#5DADE2" 
                        TextColor="Black" CornerRadius="12" 
                        Clicked="btnAuthenticate_Clicked"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>