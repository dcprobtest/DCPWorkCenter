<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.Login"
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="RainbowGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0000" Offset="0.0"/>
                <GradientStop Color="#FFFF00" Offset="0.2"/>
                <GradientStop Color="#00FF00" Offset="0.4"/>
                <GradientStop Color="#00FFFF" Offset="0.6"/>
                <GradientStop Color="#0000FF" Offset="0.8"/>
                <GradientStop Color="#FF00FF" Offset="1.0"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IgnoreSafeArea="True">

        <BoxView BackgroundColor="#22007AFF" WidthRequest="500" HeightRequest="500"
                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-200,-150,0"
                 CornerRadius="250"/>

        <BoxView BackgroundColor="#156200EE" WidthRequest="400" HeightRequest="400"
                 HorizontalOptions="Start" VerticalOptions="End" Margin="-100,0,0,-150"
                 CornerRadius="200"/>

        <BoxView BackgroundColor="#1555FF0D" WidthRequest="400" HeightRequest="400"
                 HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-150,-150"
                 CornerRadius="200"/>

        <BoxView BackgroundColor="#15E9FF00" WidthRequest="432" HeightRequest="491"
                 HorizontalOptions="Start" VerticalOptions="Start" Margin="-212,150,0,0"
                 CornerRadius="216"/>

        <Border WidthRequest="400" 
                HorizontalOptions="Center" 
                VerticalOptions="Center"
                BackgroundColor="#FFDFDFDF" 
                StrokeThickness="1" 
                Stroke="#252527"
                Padding="40">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,0" Radius="50" Opacity="0.6"/>
            </Border.Shadow>

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="lblTitle" Grid.Row="0"
                       Text="Welcome To DCP" 
                       FontSize="30" 
                       FontAttributes="Bold" 
                       TextColor="Black" 
                       HorizontalOptions="Center"
                       TranslationY="30"/>

                <Label x:Name="lblSubtitle" Grid.Row="1"
                       Text="Secure Login Portal" 
                       TextColor="#FF3C3C40" 
                       Margin="0,8,0,40" 
                       HorizontalOptions="Center" 
                       FontSize="14"
                       TranslationY="30"/>

                <Grid x:Name="gridUser" Grid.Row="2" RowSpacing="8" Margin="0,0,0,20" TranslationY="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Text="USERID" FontSize="10" FontAttributes="Bold" TextColor="#555557" Margin="5,0,0,0"/>
                    <Border Grid.Row="1" HeightRequest="45" BackgroundColor="White" Stroke="#333335" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry x:Name="txtUserId" TextColor="Black" BackgroundColor="White" PlaceholderColor="Gray" Margin="5,0"/>
                    </Border>
                </Grid>

                <Grid x:Name="gridPass" Grid.Row="3" RowSpacing="8" Margin="0,0,0,40" TranslationY="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Text="PASSWORD" FontSize="10" FontAttributes="Bold" TextColor="#555557" Margin="5,0,0,0"/>
                    <Border Grid.Row="1" HeightRequest="45" BackgroundColor="White" Stroke="#333335" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry x:Name="txtPassword" 
                               IsPassword="True" 
                               TextColor="Black" 
                               BackgroundColor="White" 
                               PlaceholderColor="Gray" 
                               Margin="5,0"/>
                    </Border>
                </Grid>

                <Grid x:Name="btnAuthenticateContainer" Grid.Row="4" 
                      HeightRequest="50" 
                      WidthRequest="320"
                      HorizontalOptions="Center"
                      TranslationY="30">

                    <Border StrokeThickness="0" BackgroundColor="Transparent" InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid IsClippedToBounds="True" WidthRequest="320" HeightRequest="50" InputTransparent="True">
                            <BoxView x:Name="rainbowRotatingBorder"
                                     WidthRequest="400" 
                                     HeightRequest="400"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     InputTransparent="True"
                                     Background="{StaticResource RainbowGradient}"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnAuthenticate"
                            Text="AUTHENTICATE" 
                            TextColor="Black"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="White"
                            Margin="2"
                            CornerRadius="10"
                            Clicked="btnAuthenticate_Clicked">
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>