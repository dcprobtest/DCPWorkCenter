<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.Main_Classfrm"
             BackgroundColor="White"
             Title="Course &amp; Content Management">

    <Grid>
        <Ellipse Fill="#152196F3" WidthRequest="600" HeightRequest="600" HorizontalOptions="End" VerticalOptions="Start" TranslationX="100" TranslationY="-200" />
        <Ellipse Fill="#109C27B0" WidthRequest="500" HeightRequest="500" HorizontalOptions="Start" VerticalOptions="End" TranslationX="-150" TranslationY="150" />

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="40">
            <Label x:Name="TitleLabel" Text="Course Content Management" FontSize="40" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333" />

            <Grid ColumnDefinitions="160, 160, 160" RowDefinitions="180, 180" ColumnSpacing="20" RowSpacing="20" HorizontalOptions="Center">

                <Border x:Name="Card1" Grid.Column="0" Grid.Row="0" WidthRequest="150" HeightRequest="160" StrokeShape="RoundRectangle 25" Background="White" Padding="10" Stroke="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#4CAF50" Data="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z" HorizontalOptions="Center" HeightRequest="60"/>
                        <Label Text="Course Module" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card2" Grid.Column="1" Grid.Row="0" WidthRequest="150" HeightRequest="160" StrokeShape="RoundRectangle 25" Background="White" Padding="10" Stroke="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#FF5722" Data="M18,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V4A2,2 0 0,0 18,2M10,4H14V6H10V4M18,20H6V18H18V20M18,16H6V4H8V16H18V16Z" HorizontalOptions="Center" HeightRequest="60"/>
                        <Label Text="Course Subject" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card3" Grid.Column="2" Grid.Row="0" WidthRequest="150" HeightRequest="160" StrokeShape="RoundRectangle 25" Background="White" Padding="10" Stroke="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#9C27B0" Data="M3,5V19L11,12M13,19V5L21,12" HorizontalOptions="Center" HeightRequest="60"/>
                        <Label Text="Subject Section" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card4" Grid.Column="0" Grid.Row="1" WidthRequest="150" HeightRequest="160" StrokeShape="RoundRectangle 25" Background="White" Padding="10" Stroke="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#2196F3" Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z" HorizontalOptions="Center" HeightRequest="60"/>
                        <Label Text="Class Video Text" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card5" Grid.Column="1" Grid.Row="1" WidthRequest="150" HeightRequest="160" StrokeShape="RoundRectangle 25" Background="White" Padding="10" Stroke="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#FF9800" Data="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10H6M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z" HorizontalOptions="Center" HeightRequest="60"/>
                        <Label Text="Section Assign" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="Card6" Grid.Column="2" Grid.Row="1" WidthRequest="150" HeightRequest="160" StrokeShape="RoundRectangle 25" Background="White" Padding="10" Stroke="Transparent" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Path Fill="#E91E63" Data="M9,16V10H5L12,3L19,10H15V16H9M5,18H19V20H5V18Z" HorizontalOptions="Center" HeightRequest="60"/>
                        <Label Text="Video Upload" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>