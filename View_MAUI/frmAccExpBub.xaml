<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ModelView_MAUI;assembly=ModelView_MAUI"
             x:Class="View_MAUI.frmAccExpBub"
             Title="Expense Head Setup"
             BackgroundColor="#F0F2F5">

    <ContentPage.Resources>
        <Style x:Key="RainbowButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="WidthRequest" Value="100"/>
            <Setter Property="HeightRequest" Value="45"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#62309C"/>
        </Style>

        <Style x:Key="ModernEntry" TargetType="Entry">
            <Setter Property="HeightRequest" Value="32"/>
            <Setter Property="BackgroundColor" Value="White"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#555"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <vm:AccExpBubViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <Grid Margin="15">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="3" BackgroundColor="White">
                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF4500" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.3"/>
                        <GradientStop Color="#00FF00" Offset="0.6"/>
                        <GradientStop Color="#00BFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Stroke>

                <Grid Margin="15" RowDefinitions="*, Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="320, *">

                        <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 15" Margin="5" Padding="20" IsVisible="{Binding IsEntryVisible}">
                            <VerticalStackLayout Spacing="15">
                                <Grid ColumnDefinitions="90, *">
                                    <Label Text="Exp Code" Style="{StaticResource LabelStyle}"/>
                                    <Picker x:Name="cmbExpCode" Grid.Column="1" Title="Select Code" HeightRequest="40" 
                                            ItemsSource="{Binding ExpCodeList}" SelectedItem="{Binding SelectedExpCode}"/>
                                </Grid>

                                <Grid ColumnDefinitions="90, *">
                                    <Label Text="Exp Detail" Style="{StaticResource LabelStyle}"/>
                                    <Entry x:Name="txtExpDetail" Grid.Column="1" Style="{StaticResource ModernEntry}" 
                                           MaxLength="30" Text="{Binding CurrentEntry.ExpDetail}"/>
                                </Grid>

                                <Grid ColumnDefinitions="90, *">
                                    <Label Text="ExpSub Code" Style="{StaticResource LabelStyle}"/>
                                    <Entry x:Name="txtExpSubCode" Grid.Column="1" Style="{StaticResource ModernEntry}" 
                                           IsReadOnly="True" BackgroundColor="#F9F9F9" Text="{Binding CurrentEntry.ExpSubCode}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 15" Margin="5" Padding="5">
                            <CollectionView x:Name="dgExpense" ItemsSource="{Binding ExpBubList}">
                                <CollectionView.Header>
                                    <Grid ColumnDefinitions="80, *, 100" BackgroundColor="#F0F0F0" Padding="5">
                                        <Label Text="Exp Code" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="Expense Detail" FontAttributes="Bold"/>
                                        <Label Grid.Column="2" Text="Sub Code" FontAttributes="Bold"/>
                                    </Grid>
                                </CollectionView.Header>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="80, *, 100" Padding="5">
                                            <Label Text="{Binding ExpCode}"/>
                                            <Label Grid.Column="1" Text="{Binding ExpDetail}"/>
                                            <Label Grid.Column="2" Text="{Binding ExpSubCode}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="5,20,5,5" ColumnDefinitions="Auto, *, Auto">
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="ADD" Style="{StaticResource RainbowButtonStyle}" Command="{Binding AddCommand}"/>
                            <Button Text="SAVE" Style="{StaticResource RainbowButtonStyle}" Command="{Binding SaveCommand}"/>
                            <Button Text="EDIT" Style="{StaticResource RainbowButtonStyle}" Command="{Binding EditCommand}"/>
                            <Button Text="EXIT" Style="{StaticResource RainbowButtonStyle}" Command="{Binding ExitCommand}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="2" Spacing="10" IsVisible="{Binding IsEntryVisible}">
                            <Entry WidthRequest="70" IsReadOnly="True" BackgroundColor="#F0F0F0" Text="{Binding CurrentEntry.UID}"/>
                            <DatePicker Date="{Binding CurrentEntry.EntryDate}"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>