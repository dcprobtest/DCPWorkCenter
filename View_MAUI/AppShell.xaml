<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="View_MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:View_MAUI">


    <ShellContent
        Title="Accounts Login"
        ContentTemplate="{DataTemplate local:AccountsLogin}"
        Route="AccountsLogin" />

    <ShellContent
        Title="Chat Box"
        ContentTemplate="{DataTemplate local:ChatBox}"
        Route="ChatBox" />

    <ShellContent
        Title="Class Module"
        ContentTemplate="{DataTemplate local:frm_ClassModule}"
        Route="frm_ClassModule" />
    
    <ShellContent
        Title="Class Section Management"
        ContentTemplate="{DataTemplate local:frm_ClassSection}"
        Route="frm_ClassSection" />
    
    <ShellContent
        Title="Document Creation"
        ContentTemplate="{DataTemplate local:frm_createdocs}"
        Route="frm_createdocs" />

    <ShellContent
        Title="Scrum Information"
        ContentTemplate="{DataTemplate local:frm_ScrumInfo}"
        Route="frm_ScrumInfo" />

    <ShellContent
        Title="STEM Management"
        ContentTemplate="{DataTemplate local:frm_STEM}"
        Route="frm_STEM" />
    <ShellContent
        Title="Technology Info"
        ContentTemplate="{DataTemplate local:frm_TechInfo}"
        Route="frm_TechInfo" />

    <ShellContent
        Title="Video Conference"
        ContentTemplate="{DataTemplate local:frm_VideoConference}"
        Route="frm_VideoConference" />

    <ShellContent
        Title="Salary Management"
        ContentTemplate="{DataTemplate local:frmAccEmpSalary}"
        Route="frmAccEmpSalary" />

    <ShellContent
        Title="Expense Head Setup"
        ContentTemplate="{DataTemplate local:frmAccExpBub}"
        Route="frmAccExpBub" />

    <ShellContent
        Title="Expense Head"
        ContentTemplate="{DataTemplate local:frmAccExpendHead}"
        Route="frmAccExpendHead" />

</Shell>