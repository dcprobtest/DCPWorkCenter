<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="View_MAUI.AccountsLogin"
             Title="Accounts Security Login"
             BackgroundColor="#F4F7F9"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="AccInputStyle" TargetType="Entry">
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="#1C1C1E"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">

        <BoxView BackgroundColor="#AF52DE"
                 Opacity="0.2"
                 CornerRadius="300"
                 AbsoluteLayout.LayoutBounds="-150, -100, 500, 500"
                 AbsoluteLayout.LayoutFlags="None"/>

        <BoxView BackgroundColor="#007AFF"
                 Opacity="0.15"
                 CornerRadius="250"
                 AbsoluteLayout.LayoutBounds="1.3, 1.2, 450, 450"
                 AbsoluteLayout.LayoutFlags="None"/>

        <FlexLayout JustifyContent="Center" AlignItems="Center"
                    AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                    AbsoluteLayout.LayoutFlags="All">

            <Border x:Name="LoginCard"
                    WidthRequest="400"
                    Padding="35, 45"
                    BackgroundColor="White"
                    Stroke="White"
                    StrokeThickness="1"
                    Opacity="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,10" Radius="30" Opacity="0.15"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <Label Text="Accounts Login" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="#1C1C1E"/>

                    <Label Text="Administrative portal for financial records." 
                           FontSize="13" 
                           TextColor="#8E8E93" 
                           Margin="0,10,0,30"/>

                    <Label Text="ADMIN ID" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" Margin="5,0,0,8"/>
                    <Border Stroke="#E5E5EA" StrokeThickness="1.5" BackgroundColor="White" Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="txtAccountUserID"
                               Style="{StaticResource AccInputStyle}"
                               IsReadOnly="True"
                               Margin="15,0"
                               Text="{Binding AdminID}"/>
                    </Border>

                    <Label Text="PASSWORD" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" Margin="5,0,0,8"/>
                    <Border Stroke="#E5E5EA" StrokeThickness="1.5" BackgroundColor="White" Margin="0,0,0,35">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry x:Name="pbAccountPassword"
                               IsPassword="True"
                               Style="{StaticResource AccInputStyle}"
                               Margin="15,0"/>
                    </Border>

                    <Button x:Name="btnAccountLogin"
                            Text="SECURE ACCESS"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="55"
                            CornerRadius="15"
                            Clicked="btnAccountLogin_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#007AFF" Offset="0.0"/>
                                <GradientStop Color="#5856D6" Offset="0.5"/>
                                <GradientStop Color="#AF52DE" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                </VerticalStackLayout>
            </Border>
        </FlexLayout>
    </AbsoluteLayout>
</ContentPage>