<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="View_MAUI.frm_ClassSection"
             Title="Class Section Management"
             BackgroundColor="#F4F7F9">

    <ScrollView>
        <Border Margin="20" StrokeShape="RoundRectangle 15" Padding="25" BackgroundColor="White">
            <Grid ColumnDefinitions="1.8*, 1*" ColumnSpacing="30">

                <Grid Grid.Column="0" RowDefinitions="*, Auto, Auto" RowSpacing="20">

                    <CollectionView Grid.Row="0" ItemsSource="{Binding ClassSectionList}" SelectedItem="{Binding SelectedClassSection}" SelectionMode="Single" HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5">
                                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="White" Stroke="#E0E0E0">
                                        <Grid ColumnDefinitions="100, *" Padding="10">
                                            <Label Grid.Column="0" Text="{Binding SectionId}" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding SectionDesc}" VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid Grid.Row="1" RowDefinitions="Auto, Auto" ColumnDefinitions="120, *">
                        <Label Grid.Row="0" Grid.Column="0" Text="Section ID" FontSize="11" TextColor="Gray"/>
                        <Entry Grid.Row="1" Grid.Column="0" Text="{Binding ClassSection.SectionId}" HeightRequest="40" BackgroundColor="White"/>

                        <Label Grid.Row="0" Grid.Column="1" Text="Section Description" FontSize="11" TextColor="Gray" Margin="10,0,0,0"/>
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding ClassSection.SectionDesc}" HeightRequest="40" Margin="10,0,0,0" BackgroundColor="White"/>
                    </Grid>

                    <HorizontalStackLayout Grid.Row="2" Spacing="15" HorizontalOptions="Start">
                        <Button Text="ADD" Command="{Binding AddCommand}" WidthRequest="80"/>
                        <Button Text="SAVE" Command="{Binding SaveCommand}" WidthRequest="80"/>
                        <Button Text="DELETE" Command="{Binding DeleteCommand}" WidthRequest="80"/>
                        <Button Text="EDIT" Command="{Binding EditCommand}" WidthRequest="80"/>
                        <Button Text="EXIT" Command="{Binding ExitCommand}" WidthRequest="80"/>
                    </HorizontalStackLayout>
                </Grid>

                <Border Grid.Column="1" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout>
                            <Label Text="User ID (Entry By)" FontSize="11" TextColor="Gray"/>
                            <Entry Text="{Binding ClassSection.EntryByUid}" HeightRequest="35" BackgroundColor="White"/>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding ClassSection.Activate}"/>
                            <Label Text="Is Active" VerticalOptions="Center" FontAttributes="Bold"/>
                            <Button Text="Active Now" Command="{Binding ActiveClickCommand}" HeightRequest="35"/>
                        </HorizontalStackLayout>

                        <Frame BorderColor="#E0E0E0" CornerRadius="8" Padding="15">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="View Timeline (Dates)" FontAttributes="Bold" TextColor="#8B5CF6"/>

                                <Label Text="Entry Date" FontSize="10" TextColor="Gray"/>
                                <Entry Text="{Binding ClassSection.EntryDate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" BackgroundColor="#F5F5F5"/>

                                <Label Text="Start Date" FontSize="10" TextColor="Gray"/>
                                <Entry Text="{Binding ClassSection.StartDate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" BackgroundColor="#F5F5F5"/>

                                <Label Text="End Date" FontSize="10" TextColor="Gray"/>
                                <Entry Text="{Binding ClassSection.EndDate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" BackgroundColor="#F5F5F5"/>

                                <Label Text="Last Update" FontSize="10" TextColor="Gray"/>
                                <Entry Text="{Binding ClassSection.LastUpdate, StringFormat='{0:dd-MMM-yyyy}'}" IsReadOnly="True" BackgroundColor="#F5F5F5"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>
    </ScrollView>
</ContentPage>